  <StreamGeometry x:Key="Icon.Send">M4 12l16-8-6 16-3-7z M11 13l9-9</StreamGeometry>
  <StreamGeometry x:Key="Icon.Check">M5 12.5l4.5 4.5L19 7.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.More">M5 12h.01 M12 12h.01 M19 12h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Copy">M9 9h10v11H9z M5 15V4h10</StreamGeometry>
  <StreamGeometry x:Key="Icon.Link">M10 14a4.2 4.2 0 0 0 6 0l3-3a4.2 4.2 0 0 0-6-6l-1.2 1.2 M14 10a4.2 4.2 0 0 0-6 0l-3 3a4.2 4.2 0 0 0 6 6l1.2-1.2</StreamGeometry>
  <StreamGeometry x:Key="Icon.Save">M5 4h11l3 3v13H5z M8 4v5h7V4 M8 20v-6h8v6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Reply">M10 7l-5 5 5 5 M5 12h9a5 5 0 0 1 5 5v1</StreamGeometry>
  <StreamGeometry x:Key="Icon.Edit">M4 20h4L19 9l-4-4L4 16z M13 7l4 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Smile">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M8.5 14a4 4 0 0 0 7 0 M9 9.5h.01 M15 9.5h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Window">M4 5h16v14H4z M4 9h16</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronRight">M9 6l6 6-6 6</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronDown">M6 9l6 6 6-6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Back">M19 12H5 M11 6l-6 6 6 6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Forward">M5 12h14 M13 6l6 6-6 6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Filter">M4 5h16l-6 8v6l-4-2v-4z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Refresh">M19 12a7 7 0 1 1-2.1-5 M19 4v4h-4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Eye">M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12z M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Folder">M3 6h6l2 2h10v11H3z</StreamGeometry>
  <StreamGeometry x:Key="Icon.File">M6 3h8l4 4v14H6z M14 3v4h4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Person">M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8z M4 20a8 8 0 0 1 16 0</StreamGeometry>
  <StreamGeometry x:Key="Icon.People">M9 5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z M2.5 20a6.5 6.5 0 0 1 13 0 M16 5.2a3.5 3.5 0 0 1 0 6.6 M18 14.5a6.5 6.5 0 0 1 3.5 5.5</StreamGeometry>
