  <StreamGeometry x:Key="Icon.Sniffer">M4 6.5h16 M4 12h10 M4 17.5h13</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sun">M12 16a4 4 0 1 0 0-8a4 4 0 1 0 0 8 M12 2.5v2 M12 19.5v2 M2.5 12h2 M19.5 12h2 M5.3 5.3l1.4 1.4 M17.3 17.3l1.4 1.4 M5.3 18.7l1.4-1.4 M17.3 6.7l1.4-1.4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Moon">M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Search">M10.5 17.5a7 7 0 1 0 0-14a7 7 0 1 0 0 14 M20.5 20.5l-5-5</StreamGeometry>
  <StreamGeometry x:Key="Icon.TrendUp">M4 16.5l5.5-5.5l3.5 3.5l7-7 M15 7.5h5v5</StreamGeometry>
  <StreamGeometry x:Key="Icon.TrendDown">M4 7.5l5.5 5.5l3.5-3.5l7 7 M15 16.5h5v-5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Alert">M12 4l9 16H3z M12 10v4 M12 17h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Settings">M4 6h10 M18 6h2 M4 12h4 M12 12h8 M4 18h12 M20 18h0 M16 4v4 M10 10v4 M18 16v4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Bell">M6 16v-5a6 6 0 0 1 12 0v5l2 2H4z M10 20a2 2 0 0 0 4 0</StreamGeometry>
