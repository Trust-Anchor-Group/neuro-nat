  <StreamGeometry x:Key="Icon.Pin">M9 4h6l-1 6 3 3H7l3-3z M12 13v7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Status">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Mention">M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z M16 8v5a2.5 2.5 0 0 0 5 0v-1a9 9 0 1 0-4 7.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Inbox">M4 13l3-8h10l3 8v6H4z M4 13h5a3 3 0 0 0 6 0h5</StreamGeometry>
</ResourceDictionary>
