<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Neuro.Nat.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Neuro.Nat.App/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#3358D4" RegionColor="#FFFFFF" />
        <ColorPaletteResources x:Key="Dark" Accent="#7B9BFF" RegionColor="#16191D" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Neuro.Nat.App/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
