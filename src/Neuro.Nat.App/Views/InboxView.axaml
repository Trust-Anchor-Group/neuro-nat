<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.Nat.App.ViewModels"
             xmlns:conv="using:Neuro.Nat.App.Converters"
             xmlns:c="using:Neuro.Nat.App.Controls"
             xmlns:views="using:Neuro.Nat.App.Views"
             x:Class="Neuro.Nat.App.Views.InboxView"
             x:DataType="vm:InboxViewModel">

  <UserControl.Styles>
    <Style Selector="Ellipse.unread">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Fill" Value="{DynamicResource Accent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.itemTitle">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.itemTitle.unread">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A row that is done steps back -->
    <Style Selector="Grid.row.done">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="Border.kindTile">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.unreadCount">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.unreadCount TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink.OnAccent}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.listPane">
      <Setter Property="Width" Value="430" />
    </Style>
    <!-- A very wide window (1800 px and up): the list gets some of the room, instead of the rest stretching -->
    <Style Selector=".wide Border.listPane">
      <Setter Property="Width" Value="540" />
    </Style>
    <Style Selector=".maxw1180 Border.listPane">
      <Setter Property="Width" Value="360" />
    </Style>
    <Style Selector=".maxw900 Border.listPane">
      <Setter Property="Width" Value="300" />
    </Style>
    <Style Selector=".maxw900 ToggleButton.seg">
      <Setter Property="Padding" Value="4,4" />
    </Style>
    <Style Selector=".maxw900 TextBlock.wideOnly">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*">

    <!-- Everything that waits for you, in one list -->
    <Border Classes="listPane" c:Pane.Key="inbox" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,14,12,12">
        <DockPanel DockPanel.Dock="Top" Margin="6,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <ToggleButton Classes="ghost" IsChecked="{Binding ShowDone}" ToolTip.Tip="Show done">
              <TextBlock Text="Show done" FontSize="{StaticResource Type.Meta}" />
            </ToggleButton>
            <Button Classes="ghost" Command="{Binding MarkAllReadCommand}" ToolTip.Tip="Mark all read">
              <TextBlock Text="Mark all read" FontSize="{StaticResource Type.Meta}" />
            </Button>
          </StackPanel>
          <TextBlock Classes="meta" Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource Ink.Primary}"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- The four parts of the list -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" Margin="0,0,0,10">
          <ToggleButton Classes="seg first" IsChecked="{Binding IsEverything, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SetTabCommand}" CommandParameter="{x:Static vm:InboxTab.Everything}" ToolTip.Tip="Everything">
            <TextBlock Text="All" />
          </ToggleButton>
          <ToggleButton Grid.Column="1" Classes="seg" IsChecked="{Binding IsMessages, Mode=OneWay}" Margin="-1,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SetTabCommand}" CommandParameter="{x:Static vm:InboxTab.Messages}" ToolTip.Tip="Unread messages">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="Messages" />
              <TextBlock Classes="num" Text="{Binding MessageCount}" IsVisible="{Binding HasMessages}" FontWeight="SemiBold" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Grid.Column="2" Classes="seg" IsChecked="{Binding IsRequests, Mode=OneWay}" Margin="-1,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SetTabCommand}" CommandParameter="{x:Static vm:InboxTab.Requests}" ToolTip.Tip="Requests">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="Requests" />
              <TextBlock Classes="num" Text="{Binding RequestCount}" IsVisible="{Binding HasRequests}" FontWeight="SemiBold" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Grid.Column="3" Classes="seg last" IsChecked="{Binding IsNeurons, Mode=OneWay}" Margin="-1,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SetTabCommand}" CommandParameter="{x:Static vm:InboxTab.Neurons}" ToolTip.Tip="Notifications">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="Neurons" />
              <TextBlock Classes="num" Text="{Binding NeuronCount}" IsVisible="{Binding HasNeurons}" FontWeight="SemiBold" />
            </StackPanel>
          </ToggleButton>
        </Grid>

        <TextBox DockPanel.Dock="Top" Classes="find" Text="{Binding SearchText}" PlaceholderText="Filter…" MinHeight="30" Padding="10,5" Margin="0,0,0,10" />

        <!-- One Neuron is picked at the top: say what that keeps out of the list -->
        <DockPanel DockPanel.Dock="Bottom" Margin="2,8,0,0" IsVisible="{Binding HasElsewhere}">
          <Button x:Name="ElsewhereButton" DockPanel.Dock="Right" Classes="link" Command="{Binding ShowElsewhereCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="Show every Neuron">
            <TextBlock Classes="meta" Text="Show all" Foreground="{DynamicResource Accent.Ink}" />
          </Button>
          <TextBlock Classes="meta" Text="{Binding ElsewhereText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- The last answer, and a moment to take it back -->
        <Border DockPanel.Dock="Bottom" Classes="panel" Padding="12,6,6,6" Margin="0,8,0,0" Background="{DynamicResource Surface.Raised}" IsVisible="{Binding HasUndo}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="small" Command="{Binding UndoCommand}" ToolTip.Tip="Take the answer back">
              <StackPanel Classes="btn">
                <c:LineIcon Classes="btn" Data="{StaticResource Icon.Undo}" />
                <TextBlock Text="Undo" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <c:LineIcon Data="{StaticResource Icon.Check}" Width="14" Height="14" Foreground="{DynamicResource State.Ok}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding UndoText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Classes="error" Text="{Binding Error}" Margin="6,8,0,0"
                   IsVisible="{Binding Error, Converter={x:Static conv:EventConverters.HasText}}" />

        <!-- Several rows picked: one answer for all of them -->
        <Border DockPanel.Dock="Bottom" Classes="panel" Padding="12,6,6,6" Margin="0,8,0,0" Background="{DynamicResource Accent.Subtle}" BorderThickness="0"
                IsVisible="{Binding HasMany}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="primary small" Content="Mark done" Command="{Binding DoneManyCommand}" />
            <TextBlock Text="{Binding ManyText}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Accent.Ink}" />
          </DockPanel>
        </Border>

        <Panel>
          <ListBox x:Name="List" Classes="rows" c:Motion.NewRows="True" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Multiple"
                   c:ActionMenu.Source="{Binding}" c:ActionMenu.KeepSelection="True">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InboxRowViewModel">
                <Grid Classes="row" Classes.done="{Binding IsDone}" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Classes="kindTile" Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}, ConverterParameter=subtle}">
                    <c:LineIcon Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}" Width="16" Height="16"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="meta" Text="{Binding TimeText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="unread" IsVisible="{Binding IsUnread}" />
                        <TextBlock Classes="caption" Text="{Binding KindLabel}" VerticalAlignment="Center" />
                        <Border Classes="unreadCount" IsVisible="{Binding HasCount}">
                          <TextBlock Text="{Binding Count}" />
                        </Border>
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Classes="itemTitle" Classes.unread="{Binding IsUnread}" Text="{Binding Title}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="meta" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Detail, Converter={x:Static conv:EventConverters.HasText}}" />
                    <!-- The answer, on the row -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,1" IsVisible="{Binding HasPrimary}">
                      <Button Classes="small" Classes.primary="{Binding IsRequest}" Content="{Binding PrimaryText}"
                              Command="{Binding $parent[UserControl].((vm:InboxViewModel)DataContext).PrimaryCommand}" CommandParameter="{Binding}" />
                      <Button Classes="small" Content="{Binding SecondaryText}" IsVisible="{Binding HasSecondary}"
                              Command="{Binding $parent[UserControl].((vm:InboxViewModel)DataContext).SecondaryCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding !HasRows}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="310" Spacing="6">
            <c:LineIcon Data="{StaticResource Icon.Check}" Width="26" Height="26" Foreground="{DynamicResource State.Ok}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Classes="meta" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static conv:EventConverters.HasText}}" />
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>

    <!-- The open row -->
    <Panel Grid.Column="1">
      <views:AttentionView DataContext="{Binding Notifications}" IsVisible="{Binding $parent[UserControl].((vm:InboxViewModel)DataContext).ShowsNotification}" />
      <views:ConversationView DataContext="{Binding Chat}" IsVisible="{Binding $parent[UserControl].((vm:InboxViewModel)DataContext).ShowsConversation}" />

      <!-- A request: what it means, and its answer -->
      <ScrollViewer IsVisible="{Binding ShowsRequest}">
        <StackPanel DataContext="{Binding SelectedRow}" x:DataType="vm:InboxRowViewModel" Margin="24,18,24,20" MaxWidth="620" HorizontalAlignment="Left" Spacing="10">
          <Border Classes="pill" Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}, ConverterParameter=subtle}">
            <TextBlock Text="{Binding KindLabel}" Foreground="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
          </Border>
          <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource Ink.Secondary}"
                               IsVisible="{Binding Detail, Converter={x:Static conv:EventConverters.HasText}}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding AccountLabel, Converter={x:Static conv:EventConverters.HasText}}">
              <Border Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                      Background="{Binding AccountColorIndex, Converter={x:Static conv:AccountHueConverter.Instance}, ConverterParameter=subtle}">
                <TextBlock Text="{Binding AccountLabel, Converter={x:Static conv:InitialConverter.Instance}}" FontSize="10" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding AccountColorIndex, Converter={x:Static conv:AccountHueConverter.Instance}}" />
              </Border>
              <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding AccountLabel, StringFormat='To {0}'}" />
            </StackPanel>
            <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding TimeText}" />
          </StackPanel>
          <Border Classes="panel" Padding="14,12" Margin="0,4,0,0">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" LineHeight="19" IsVisible="{Binding Explanation, Converter={x:Static conv:EventConverters.HasText}}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="{Binding PrimaryText}" IsVisible="{Binding HasPrimary}"
                        Command="{Binding $parent[UserControl].((vm:InboxViewModel)DataContext).PrimaryCommand}" CommandParameter="{Binding}" />
                <Button Content="{Binding SecondaryText}" IsVisible="{Binding HasSecondary}"
                        Command="{Binding $parent[UserControl].((vm:InboxViewModel)DataContext).SecondaryCommand}" CommandParameter="{Binding}" />
                <Button Classes="ghost" Content="Answer for a whole domain in Devices" IsVisible="{Binding IsDeviceQuestion}"
                        Command="{Binding $parent[UserControl].((vm:InboxViewModel)DataContext).ShowDevicesCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel IsVisible="{Binding HasMany}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Spacing="6">
        <TextBlock Text="{Binding ManyText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
      </StackPanel>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Spacing="6">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!HasSelection" />
            <Binding Path="!HasMany" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <TextBlock Text="Pick a row to open it" FontWeight="SemiBold" HorizontalAlignment="Center" />
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>
