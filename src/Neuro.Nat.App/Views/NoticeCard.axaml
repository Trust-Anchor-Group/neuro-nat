<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.Nat.App.ViewModels"
             xmlns:conv="using:Neuro.Nat.App.Converters"
             xmlns:c="using:Neuro.Nat.App.Controls"
             x:Class="Neuro.Nat.App.Views.NoticeCard"
             x:DataType="vm:NoticeViewModel">

  <UserControl.Styles>
    <!-- The bar on the left and the caption take the colour of what happened. -->
    <Style Selector="Border.tone">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.tone.bad">
      <Setter Property="Background" Value="{DynamicResource State.Bad}" />
    </Style>
    <Style Selector="Border.tone.busy">
      <Setter Property="Background" Value="{DynamicResource State.Busy}" />
    </Style>
    <Style Selector="Border.tone.ok">
      <Setter Property="Background" Value="{DynamicResource State.Ok}" />
    </Style>
    <Style Selector="TextBlock.tone">
      <Setter Property="Foreground" Value="{DynamicResource Accent.Ink}" />
      <Setter Property="LetterSpacing" Value="0.3" />
    </Style>
    <Style Selector="TextBlock.tone.bad">
      <Setter Property="Foreground" Value="{DynamicResource State.Bad}" />
    </Style>
    <Style Selector="TextBlock.tone.busy">
      <Setter Property="Foreground" Value="{DynamicResource State.Busy}" />
    </Style>
    <Style Selector="TextBlock.tone.ok">
      <Setter Property="Foreground" Value="{DynamicResource State.Ok}" />
    </Style>
    <Style Selector="Button.mini">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="2,-3,0,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="Card" Classes="float" ClipToBounds="True" Cursor="Hand" ToolTip.Tip="Click to open">
    <Grid ColumnDefinitions="4,*">
      <Border Classes="tone" Classes.bad="{Binding IsBad}" Classes.busy="{Binding IsBusy}" Classes.ok="{Binding IsOk}" />

      <StackPanel Grid.Column="1" Margin="13,10,8,12" Spacing="4">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="ghost mini" Command="{Binding CloseCommand}" ToolTip.Tip="Close" AutomationProperties.Name="Close">
            <c:LineIcon Data="{StaticResource Icon.Close}" Width="13" Height="13" />
          </Button>
          <Button DockPanel.Dock="Right" Classes="ghost mini" IsVisible="{Binding CanMute}" ToolTip.Tip="Mute"
                  AutomationProperties.Name="Mute">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Mute for an hour" Command="{Binding MuteHourCommand}" />
                <MenuItem Header="Mute until tomorrow" Command="{Binding MuteTomorrowCommand}" />
                <MenuItem Header="Mute until I turn it back on" Command="{Binding MuteForGoodCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            <c:LineIcon Data="{StaticResource Icon.BellOff}" Width="13" Height="13" />
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="caption tone" Classes.bad="{Binding IsBad}" Classes.busy="{Binding IsBusy}" Classes.ok="{Binding IsOk}"
                       Text="{Binding Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="caption" Text="{Binding MoreText}" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>

        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
        <TextBlock Classes="meta" Text="{Binding Detail}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                   IsVisible="{Binding Detail, Converter={x:Static conv:EventConverters.HasText}}" />
        <TextBlock Classes="error" Text="{Binding Error}" Margin="0,0,8,0"
                   IsVisible="{Binding Error, Converter={x:Static conv:EventConverters.HasText}}" />

        <!-- Answer a message right here -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,5,6,0" IsVisible="{Binding CanReply}">
          <TextBox x:Name="ReplyBox" Text="{Binding ReplyText}" PlaceholderText="Reply…" MinHeight="30" Padding="9,5" Cursor="Ibeam"
                   AutomationProperties.Name="Reply" />
          <Button Grid.Column="1" Classes="primary" Command="{Binding SendReplyCommand}" MinHeight="30" Padding="9,0" ToolTip.Tip="Send (Enter)"
                  AutomationProperties.Name="Send reply">
            <c:LineIcon Data="{StaticResource Icon.Send}" Width="14" Height="14" />
          </Button>
        </Grid>

        <!-- Answer a request right here -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,6,0" IsVisible="{Binding HasActions}">
          <Button Classes="primary" Content="{Binding PrimaryText}" Command="{Binding RunPrimaryCommand}" IsVisible="{Binding HasPrimary}" MinHeight="28" />
          <Button Content="{Binding SecondaryText}" Command="{Binding RunSecondaryCommand}" IsVisible="{Binding HasSecondary}" MinHeight="28" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
