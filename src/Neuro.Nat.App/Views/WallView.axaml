<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.Nat.App.ViewModels"
             xmlns:conv="using:Neuro.Nat.App.Converters"
             xmlns:c="using:Neuro.Nat.App.Controls"
             x:Class="Neuro.Nat.App.Views.WallView"
             x:DataType="vm:WallViewModel"
             Background="{DynamicResource Surface.Ground}">

  <UserControl.Styles>
    <Style Selector="TextBlock.wallNum">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFeatures" Value="tnum" />
    </Style>
    <Style Selector="TextBlock.wallNum.alarm">
      <Setter Property="Foreground" Value="{DynamicResource State.Bad}" />
    </Style>
    <Style Selector="TextBlock.wallCap">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.Tertiary}" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.wallSub">
      <Setter Property="Foreground" Value="{DynamicResource Ink.Secondary}" />
    </Style>
    <Style Selector="TextBlock.wallBad">
      <Setter Property="Foreground" Value="{DynamicResource State.Bad}" />
    </Style>
    <Style Selector="Border.wallTile">
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
  </UserControl.Styles>

  <!-- The wall is drawn for a 1280 px wide screen and scaled to the one it is on, so it is as large as the screen allows. -->
  <LayoutTransformControl x:Name="Scale">
    <DockPanel x:Name="Stage" Margin="34,26,34,22">

      <!-- How it all is, and the time -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,24">
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
          <TextBlock x:Name="ClockText" Text="{Binding Clock}" FontSize="46" FontWeight="SemiBold" FontFeatures="tnum" HorizontalAlignment="Right" LineHeight="48" />
          <TextBlock Text="{Binding Date}" FontSize="15" Foreground="{DynamicResource Ink.Secondary}" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Ellipse Width="18" Height="18" VerticalAlignment="Center" Fill="{Binding SummaryTone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
            <TextBlock x:Name="SummaryText" Text="{Binding Summary}" FontSize="34" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock x:Name="ErrorsText" Text="{Binding ErrorsText}" FontSize="17" Margin="32,6,0,0"
                     Classes="wallSub" Classes.wallBad="{Binding HasErrors}" />
        </StackPanel>
      </DockPanel>

      <TextBlock DockPanel.Dock="Bottom" x:Name="LeaveHint" Text="Esc or F11 to leave" FontSize="12" Foreground="{DynamicResource Ink.Tertiary}" HorizontalAlignment="Right" Margin="0,8,0,0" />

      <!-- The latest warnings and errors -->
      <Border DockPanel.Dock="Right" Width="400" Margin="10,0,0,0" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
        <DockPanel Margin="20,16,20,10">
          <TextBlock DockPanel.Dock="Top" Text="Latest problems" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
          <Panel>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasLatest}" Spacing="6">
              <TextBlock Text="All quiet" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource State.Ok}" />
              <TextBlock Text="No warnings or errors have come in." FontSize="14" Foreground="{DynamicResource Ink.Secondary}" HorizontalAlignment="Center" />
            </StackPanel>
            <ItemsControl x:Name="LatestList" ItemsSource="{Binding Latest}" IsVisible="{Binding HasLatest}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:WholeStack />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WallEventViewModel">
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,9">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,12,2"
                              Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                      <DockPanel DockPanel.Dock="Top">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="13" Foreground="{DynamicResource Ink.Tertiary}" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding Neuron}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{DynamicResource Ink.Secondary}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBlock Text="{Binding Title}" FontSize="16" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </DockPanel>
      </Border>

      <!-- Every Neuron, as a tile -->
      <Panel x:Name="TileHost">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasTiles}" Spacing="8">
          <TextBlock Text="No Neurons yet" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>
        <!-- However many there are, all of them show: with more than fit, the tiles get smaller together. -->
        <Viewbox x:Name="TileBox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasTiles}">
          <ItemsControl x:Name="TileList" ItemsSource="{Binding Tiles}" Width="802">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Columns}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WallTileViewModel">
                <Border Classes="wallTile">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="6" Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                    <StackPanel Margin="16,13,16,14">
                      <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding StateText}" FontSize="14" Margin="0,3,0,12"
                                 Foreground="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                      <Grid ColumnDefinitions="5*,4*,4*" ColumnSpacing="10">
                        <StackPanel>
                          <TextBlock Classes="wallNum" Classes.alarm="{Binding HighCpu}" Text="{Binding Cpu}" />
                          <TextBlock Classes="wallCap" Text="CPU" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Classes="wallNum" Classes.alarm="{Binding HasErrors}" Text="{Binding Errors}" />
                          <TextBlock Classes="wallCap" Text="Errors, 1 h" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Classes="wallNum" Text="{Binding Issues}" />
                          <TextBlock Classes="wallCap" Text="Problems" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="5*,4*,4*" ColumnSpacing="10" Margin="0,12,0,0">
                        <StackPanel>
                          <TextBlock FontSize="15" FontWeight="Medium" Text="{Binding Memory}" Classes.wallBad="{Binding LowMemory}" />
                          <TextBlock Classes="wallCap" Text="Memory" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock FontSize="15" FontWeight="Medium" Text="{Binding Disk}" Classes.wallBad="{Binding LowDisk}" />
                          <TextBlock Classes="wallCap" Text="Disk free" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Classes="wallCap" Margin="0,12,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="Last event" />
                        <Run Text="{Binding LastEvent}" />
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Viewbox>
      </Panel>
    </DockPanel>
  </LayoutTransformControl>
</UserControl>
