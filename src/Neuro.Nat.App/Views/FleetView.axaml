<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.Nat.App.ViewModels"
             xmlns:conv="using:Neuro.Nat.App.Converters"
             xmlns:c="using:Neuro.Nat.App.Controls"
             x:Class="Neuro.Nat.App.Views.FleetView"
             x:DataType="vm:FleetViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.th">
      <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.Secondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.th.arrow">
      <Setter Property="Foreground" Value="{DynamicResource Accent.Ink}" />
    </Style>
    <!-- A column's name is a button: click to sort by it -->
    <Style Selector="Button.th">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.th:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.th:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.th:pointerover TextBlock.th">
      <Setter Property="Foreground" Value="{DynamicResource Ink.Primary}" />
    </Style>
    <Style Selector="Button.th:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource Severity.Warning}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{DynamicResource Severity.Error}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- The columns that hold numbers have widths of their own; the name and the stream share what is left.
         A column that is hidden takes no room, so the name is not squeezed. -->
    <Style Selector="Grid.cols">
      <Setter Property="ColumnSpacing" Value="12" />
    </Style>
    <Style Selector=":is(Control).colVersion">
      <Setter Property="Width" Value="170" />
    </Style>
    <Style Selector=":is(Control).colCpu">
      <Setter Property="Width" Value="132" />
    </Style>
    <Style Selector=":is(Control).colMem">
      <Setter Property="Width" Value="180" />
    </Style>
    <Style Selector=":is(Control).colDisk">
      <Setter Property="Width" Value="96" />
    </Style>
    <Style Selector=".wide :is(Control).colVersion">
      <Setter Property="Width" Value="230" />
    </Style>
    <!-- Narrow windows drop the version and disk columns. -->
    <!-- Window width 1180 px or less (classes set by MainWindow; container queries made list scrolling slow) -->
    <Style Selector=".maxw1180 :is(Control).colWide">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".maxw1000 :is(Control).colMem">
      <Setter Property="Width" Value="112" />
    </Style>
    <!-- Small windows keep what tells you something is wrong: the name, the stream, CPU as a number, errors, issues and the last event. -->
    <Style Selector=".maxw860 Grid.cols">
      <Setter Property="ColumnSpacing" Value="8" />
    </Style>
    <Style Selector=".maxw860 :is(Control).colMem, .maxw860 c|Sparkline.cpu, .maxw860 TextBlock.cpuLong">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".maxw860 :is(Control).colCpu">
      <Setter Property="Width" Value="48" />
    </Style>
    <Style Selector=":is(Control).colErrors">
      <Setter Property="Width" Value="72" />
    </Style>
    <Style Selector=":is(Control).colProblems, :is(Control).colLast">
      <Setter Property="Width" Value="84" />
    </Style>
    <Style Selector=".maxw860 :is(Control).colErrors">
      <Setter Property="Width" Value="60" />
    </Style>
    <Style Selector=".maxw860 :is(Control).colProblems">
      <Setter Property="Width" Value="60" />
    </Style>
    <Style Selector=".maxw860 :is(Control).colLast">
      <Setter Property="Width" Value="72" />
    </Style>
    <!-- The stream says what it does, and under it what it read before; a small window keeps the first line. -->
    <Style Selector=".maxw860 Panel.historyLine">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.short">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".maxw860 TextBlock.short">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector=".maxw860 TextBlock.long">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBox.fleetFind">
      <Setter Property="Width" Value="220" />
    </Style>
    <Style Selector=".maxw860 TextBox.fleetFind">
      <Setter Property="Width" Value="140" />
    </Style>
    
  </UserControl.Styles>

  <DockPanel Margin="20,16,20,20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <TextBox Classes="find fleetFind" Text="{Binding FilterText}" PlaceholderText="Filter Neurons…" MinHeight="28" Padding="10,4"
                 ToolTip.Tip="Filter by name, account, version or state (Ctrl+F)" />
        <Button Classes="ghost" Command="{Binding RefreshNowCommand}" ToolTip.Tip="Read every Neuron's health now (F5)">
          <StackPanel Classes="btn">
            <c:LineIcon Classes="btn" Data="{StaticResource Icon.Refresh}" />
            <TextBlock Classes="btnLabel" Text="Refresh" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding SaveCommand}" ToolTip.Tip="Save the list to a file">
          <c:LineIcon Classes="btn" Data="{StaticResource Icon.Save}" />
        </Button>
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
        <TextBlock Classes="section" Text="Neurons" />
        <TextBlock Grid.Column="1" Classes="meta" Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                   ToolTip.Tip="{Binding Summary}" />
      </Grid>
    </DockPanel>

    <Border Classes="panel">
      <DockPanel>
        <!-- Column headers -->
        <Border DockPanel.Dock="Top" Padding="14,9" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
          <Grid Classes="cols" ColumnDefinitions="2.4*,1.3*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <Button Classes="th" Command="{Binding SortByCommand}" CommandParameter="name" ToolTip.Tip="Sort by name">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="Neuron" />
                <TextBlock Classes="th arrow" Text="{Binding NameArrow}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="th" Command="{Binding SortByCommand}" CommandParameter="stream" ToolTip.Tip="Sort by stream">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="Stream" />
                <TextBlock Classes="th arrow" Text="{Binding StreamArrow}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="th colWide colVersion" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Command="{Binding SortByCommand}" CommandParameter="version" ToolTip.Tip="Sort by version">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="Version" />
                <TextBlock Classes="th arrow" Text="{Binding VersionArrow}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="th colCpu" HorizontalContentAlignment="Left" Command="{Binding SortByCommand}" CommandParameter="cpu" ToolTip.Tip="Sort by CPU">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="CPU" />
                <TextBlock Classes="th cpuLong" Text="last 30 min" FontWeight="Normal" />
                <TextBlock Classes="th arrow" Text="{Binding CpuArrow}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="th colMem" HorizontalContentAlignment="Left" Command="{Binding SortByCommand}" CommandParameter="memory" ToolTip.Tip="Sort by memory">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="Memory" />
                <TextBlock Classes="th arrow" Text="{Binding MemoryArrow}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="5" Classes="th colWide colDisk" HorizontalContentAlignment="Left" Command="{Binding SortByCommand}" CommandParameter="disk" ToolTip.Tip="Sort by free disk">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="Disk" />
                <TextBlock Classes="th arrow" Text="{Binding DiskArrow}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="6" Classes="th colErrors" HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="errors" ToolTip.Tip="Sort by errors" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="Errors 1 h" />
                <TextBlock Classes="th arrow" Text="{Binding ErrorsArrow}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="7" Classes="th colProblems" HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="issues" ToolTip.Tip="Sort by open problems" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th long" Text="Open problems" />
                <TextBlock Classes="th short" Text="Problems" />
                <TextBlock Classes="th arrow" Text="{Binding IssuesArrow}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="8" Classes="th colLast" HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="last" ToolTip.Tip="Sort by last event" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="th" Text="Last event" />
                <TextBlock Classes="th arrow" Text="{Binding LastArrow}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <Panel>
          <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Shown}" SelectedItem="{Binding SelectedRow}" Margin="4" SelectionMode="Multiple"
                   c:ActionMenu.Source="{Binding}" c:ActionMenu.Bar="{Binding #Bar}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FleetRowViewModel">
                <Grid Classes="cols" ColumnDefinitions="2.4*,1.3*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Ellipse Classes="dot" VerticalAlignment="Center"
                             Classes.ok="{Binding State, Converter={x:Static conv:EventConverters.IsLive}}"
                             Classes.busy="{Binding State, Converter={x:Static conv:EventConverters.IsPending}}"
                             Classes.bad="{Binding State, Converter={x:Static conv:EventConverters.IsProblem}}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <Button Classes="link" Command="{Binding $parent[UserControl].((vm:FleetViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding BareJid}">
                        <TextBlock Classes="mono" Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </Button>
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,5,0" IsVisible="{Binding ShowAccount}"
                                Background="{Binding AccountColorIndex, Converter={x:Static conv:AccountHueConverter.Instance}, ConverterParameter=subtle}">
                          <TextBlock Text="{Binding AccountLabel, Converter={x:Static conv:InitialConverter.Instance}}" FontSize="9" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{Binding AccountColorIndex, Converter={x:Static conv:AccountHueConverter.Instance}}" />
                        </Border>
                        <!-- What the last check for updates came to. It keeps its place; the account's name gives way. -->
                        <Border DockPanel.Dock="Right" Classes="pill" Margin="8,0,0,0" IsVisible="{Binding HasUpdateNote}"
                                Background="{Binding UpdateTone, Converter={x:Static conv:ToneBrushConverter.Instance}, ConverterParameter=subtle}">
                          <TextBlock Text="{Binding UpdateNote}" Foreground="{Binding UpdateTone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                        </Border>
                        <TextBlock Classes="meta" Text="{Binding AccountLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding ShowAccount}" />
                      </DockPanel>
                    </StackPanel>
                  </Grid>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding StateText}">
                    <TextBlock Classes="meta" Text="{Binding StateLine}" TextWrapping="Wrap" />
                    <Panel Classes="historyLine">
                      <TextBlock Classes="meta" Text="{Binding HistoryLine}" TextWrapping="Wrap" Foreground="{DynamicResource Ink.Tertiary}"
                                 IsVisible="{Binding HistoryLine, Converter={x:Static conv:EventConverters.HasText}}" />
                    </Panel>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="meta colWide colVersion" Text="{Binding Software}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <StackPanel Grid.Column="3" Classes="colCpu" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="num" Classes.warn="{Binding HighCpu}" Text="{Binding CpuText}" Width="40" VerticalAlignment="Center" />
                    <c:Sparkline Classes="cpu" Values="{Binding CpuSeries}" Width="72" Height="16" Foreground="{DynamicResource Accent}" />
                  </StackPanel>
                  <TextBlock Grid.Column="4" Classes="num colMem" Classes.warn="{Binding LowMemory}" Text="{Binding MemoryText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="5" Classes="num colWide colDisk" Classes.warn="{Binding LowDisk}" Text="{Binding DiskText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="6" Classes="num colErrors" Classes.bad="{Binding HasErrors}" Text="{Binding ErrorsLastHour}" TextAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="7" Classes="num colProblems" Text="{Binding OpenIssues}" TextAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="8" Classes="meta colLast" Text="{Binding LastEventText}" TextAlignment="Right" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="1" Grid.ColumnSpan="9" Classes="meta" Margin="18,6,0,0" TextWrapping="Wrap"
                             Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static conv:EventConverters.HasText}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <c:ActionBar x:Name="Bar" Noun="Neuron" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" MinWidth="440" />

          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="HasRows" />
                <Binding Path="!HasShown" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <TextBlock Text="No Neuron matches the filter" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel IsVisible="{Binding !HasRows}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Spacing="6">
            <c:LineIcon Data="{StaticResource Icon.Fleet}" Width="24" Height="24" Foreground="{DynamicResource Ink.Tertiary}" HorizontalAlignment="Center" />
            <TextBlock Text="No Neurons found yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
