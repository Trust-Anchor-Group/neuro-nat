<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.Nat.App.ViewModels"
             xmlns:c="using:Neuro.Nat.App.Controls"
             x:Class="Neuro.Nat.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Float}" />
      <Setter Property="Padding" Value="20,16,20,18" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="{StaticResource Type.Meta}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="18" />
    </Style>
    <!-- One of a few choices, with an icon: status and look -->
    <Style Selector="ToggleButton.choice">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="MinWidth" Value="132" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <!-- The pop-up and sound table -->
    <Style Selector="Grid.matrix > TextBlock.what">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,7,16,7" />
    </Style>
    <Style Selector="Grid.matrix > CheckBox">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Grid.matrix > Border.rule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Line}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24,18,24,28" MaxWidth="760" HorizontalAlignment="Left" Spacing="14">

      <!-- Your status -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Your status" />
          <WrapPanel Orientation="Horizontal">
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsAvailable, Mode=OneWay}"
                          Command="{Binding SetStatusCommand}" CommandParameter="{x:Static vm:OwnStatus.Available}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Ellipse Classes="dot ok" VerticalAlignment="Center" />
                <TextBlock Text="Available" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsAway, Mode=OneWay}"
                          Command="{Binding SetStatusCommand}" CommandParameter="{x:Static vm:OwnStatus.Away}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Ellipse Classes="dot busy" VerticalAlignment="Center" />
                <TextBlock Text="Away" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsDoNotDisturb, Mode=OneWay}"
                          Command="{Binding SetStatusCommand}" CommandParameter="{x:Static vm:OwnStatus.DoNotDisturb}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Ellipse Classes="dot bad" VerticalAlignment="Center" />
                <TextBlock Text="Do not disturb" />
              </StackPanel>
            </ToggleButton>
          </WrapPanel>
          <TextBlock Classes="hint" Text="{Binding StatusHint}" />
        </StackPanel>
      </Border>

      <!-- Pop-ups and sounds -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Pop-ups and sounds" />
          <TextBlock Classes="hint"
                     Text="A pop-up shows in the corner of the window, or in the corner of the screen when the window is behind others or closed to the tray. Whatever you turn off here still counts in the Inbox." />

          <WrapPanel Orientation="Horizontal">
            <ToggleButton x:Name="AlertsNeedsMe" Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsAlertsNeedsMe, Mode=OneWay}"
                          Command="{Binding SetAlertsCommand}" CommandParameter="needsMe">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:LineIcon Data="{StaticResource Icon.Bell}" VerticalAlignment="Center" />
                <TextBlock Text="What needs me" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="AlertsEverything" Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsAlertsEverything, Mode=OneWay}"
                          Command="{Binding SetAlertsCommand}" CommandParameter="everything">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:LineIcon Data="{StaticResource Icon.Inbox}" VerticalAlignment="Center" />
                <TextBlock Text="Everything" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="AlertsNothing" Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsAlertsNothing, Mode=OneWay}"
                          Command="{Binding SetAlertsCommand}" CommandParameter="nothing">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:LineIcon Data="{StaticResource Icon.BellOff}" VerticalAlignment="Center" />
                <TextBlock Text="Nothing" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="AlertsOwn" Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsAlertsOwn, Mode=OneWay}"
                          Command="{Binding SetAlertsCommand}" CommandParameter="own">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:LineIcon Data="{StaticResource Icon.Settings}" VerticalAlignment="Center" />
                <TextBlock Text="My own choice" />
              </StackPanel>
            </ToggleButton>
          </WrapPanel>
          <TextBlock Classes="hint" Text="{Binding AlertsHint}" />

          <Grid x:Name="AlertKinds" Classes="matrix" ColumnDefinitions="*,84,84" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0" IsVisible="{Binding IsAlertsOwn}">
            <TextBlock Grid.Column="1" Classes="caption" Text="POP-UP" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Grid.Column="2" Classes="caption" Text="SOUND" HorizontalAlignment="Center" Margin="0,0,0,6" />

            <Border Grid.Row="1" Classes="rule" />
            <TextBlock Grid.Row="1" Classes="what" Text="Chat messages, from people and from rooms as each room is set" />
            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding PopMessages}" AutomationProperties.Name="Pop-up for chat messages" />
            <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding SoundMessages}" AutomationProperties.Name="Sound for chat messages" />

            <Border Grid.Row="2" Classes="rule" />
            <TextBlock Grid.Row="2" Classes="what" Text="Requests: contact requests, room invitations, questions from devices, requests for your identity" />
            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding PopRequests}" AutomationProperties.Name="Pop-up for requests" />
            <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding SoundRequests}" AutomationProperties.Name="Sound for requests" />

            <Border Grid.Row="3" Classes="rule" />
            <TextBlock Grid.Row="3" Classes="what" Text="Notifications from Neurons that need someone" />
            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding PopNotifications}" AutomationProperties.Name="Pop-up for notifications" />
            <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="{Binding SoundNotifications}" AutomationProperties.Name="Sound for notifications" />

            <Border Grid.Row="4" Classes="rule" />
            <TextBlock Grid.Row="4" Classes="what" Text="New errors, and errors that come back" />
            <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding PopErrors}" AutomationProperties.Name="Pop-up for errors" />
            <CheckBox Grid.Row="4" Grid.Column="2" IsChecked="{Binding SoundErrors}" AutomationProperties.Name="Sound for errors and Neurons going down"
                      ToolTip.Tip="One switch for errors and for Neurons going down: they share the same sound" />

            <Border Grid.Row="5" Classes="rule" />
            <TextBlock Grid.Row="5" Classes="what" Text="A Neuron stops answering, and when it is back" />
            <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding PopNeuronDown}" AutomationProperties.Name="Pop-up for Neurons going down" />
            <CheckBox Grid.Row="5" Grid.Column="2" IsChecked="{Binding SoundErrors}" AutomationProperties.Name="Sound for errors and Neurons going down"
                      ToolTip.Tip="One switch for errors and for Neurons going down: they share the same sound" />

            <Border Grid.Row="6" Classes="rule" />
            <TextBlock Grid.Row="6" Classes="what" Text="Information only: updates, restarts, backups" />
            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding PopInformation}" AutomationProperties.Name="Pop-up for information" />
            <CheckBox Grid.Row="6" Grid.Column="2" IsChecked="{Binding SoundInformation}" AutomationProperties.Name="Sound for information" />
          </Grid>

          <TextBlock Classes="hint"
                     Text="A person or a room can be muted on its own, from the bell at the top of its conversation or from its pop-up. A message that mentions you in a room always gets through, unless the room is muted." />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0" IsVisible="{Binding CanTest}">
            <Button Command="{Binding TestMessageCommand}" ToolTip.Tip="Shows a made-up message pop-up and plays the message sound">
              <StackPanel Classes="btn">
                <c:LineIcon Classes="btn" Data="{StaticResource Icon.Chat}" />
                <TextBlock Text="Try a message" />
              </StackPanel>
            </Button>
            <Button Command="{Binding TestAlertCommand}" ToolTip.Tip="Shows a made-up alert from a Neuron and plays the alert sound">
              <StackPanel Classes="btn">
                <c:LineIcon Classes="btn" Data="{StaticResource Icon.Alert}" />
                <TextBlock Text="Try an alert" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- The look -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Look" />
          <WrapPanel Orientation="Horizontal">
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsLookLight, Mode=OneWay}"
                          Command="{Binding SetLookCommand}" CommandParameter="{x:Static vm:LookChoice.Light}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:LineIcon Data="{StaticResource Icon.Sun}" VerticalAlignment="Center" />
                <TextBlock Text="Light" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsLookDark, Mode=OneWay}"
                          Command="{Binding SetLookCommand}" CommandParameter="{x:Static vm:LookChoice.Dark}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:LineIcon Data="{StaticResource Icon.Moon}" VerticalAlignment="Center" />
                <TextBlock Text="Dark" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsLookSystem, Mode=OneWay}"
                          Command="{Binding SetLookCommand}" CommandParameter="{x:Static vm:LookChoice.System}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:LineIcon Data="{StaticResource Icon.Window}" VerticalAlignment="Center" />
                <TextBlock Text="Same as the system" />
              </StackPanel>
            </ToggleButton>
          </WrapPanel>
          <CheckBox x:Name="LessMotionBox" IsChecked="{Binding LessMotion}" Content="Less motion" />
          <TextBlock Classes="hint" Margin="28,-6,0,0" Text="Nothing fades or slides in. Motion is also off when Windows is set to show no animations." />
        </StackPanel>
      </Border>

      <!-- Sizes -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="Text size" />
            <TextBlock Classes="hint" Text="Everything grows with the text, so nothing is cut off. Ctrl+plus and Ctrl+minus change it from anywhere, Ctrl+0 puts it back." />
          </StackPanel>
          <WrapPanel Orientation="Horizontal">
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsTextSmall, Mode=OneWay}" Command="{Binding SetTextSizeCommand}">
              <ToggleButton.CommandParameter><x:Int32>90</x:Int32></ToggleButton.CommandParameter>
              <TextBlock Text="Small" FontSize="11.5" VerticalAlignment="Center" />
            </ToggleButton>
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsTextNormal, Mode=OneWay}" Command="{Binding SetTextSizeCommand}">
              <ToggleButton.CommandParameter><x:Int32>100</x:Int32></ToggleButton.CommandParameter>
              <TextBlock Text="Normal" FontSize="13" VerticalAlignment="Center" />
            </ToggleButton>
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsTextLarge, Mode=OneWay}" Command="{Binding SetTextSizeCommand}">
              <ToggleButton.CommandParameter><x:Int32>115</x:Int32></ToggleButton.CommandParameter>
              <TextBlock Text="Large" FontSize="15" VerticalAlignment="Center" />
            </ToggleButton>
            <ToggleButton Classes="choice" Margin="0,0,8,8" IsChecked="{Binding IsTextLarger, Mode=OneWay}" Command="{Binding SetTextSizeCommand}">
              <ToggleButton.CommandParameter><x:Int32>130</x:Int32></ToggleButton.CommandParameter>
              <TextBlock Text="Larger" FontSize="17" VerticalAlignment="Center" />
            </ToggleButton>
          </WrapPanel>
          <CheckBox IsChecked="{Binding CompactRows}" Content="Compact rows" />
          <TextBlock Classes="hint" Margin="28,-6,0,0" Text="Rows in lists take less height, so more of them fit on the screen." />
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
            <Button x:Name="ResetLayoutButton" Classes="small" Command="{Binding ResetLayoutCommand}" Content="Put the layout back" IsEnabled="{Binding HasOwnLayout}" />
            <TextBlock Classes="hint" VerticalAlignment="Center" Text="Panes you made wider or narrower, and how the Neurons list is sorted." />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- The app -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="When the window closes" />
          <CheckBox IsChecked="{Binding KeepRunningInTray}" Content="Keep watching from the tray" />
          <TextBlock Classes="hint" Margin="28,-6,0,0"
                     Text="Closing the window then hides it. Pop-ups and sounds keep coming, and the dot in the tray icon shows how things stand. Quit from the tray icon's menu." />
          <CheckBox IsChecked="{Binding StartWithSystem}" Content="Start when I sign in to Windows" IsVisible="{Binding CanAutostart}" />
          <TextBlock Classes="hint" Margin="28,-6,0,0" IsVisible="{Binding CanAutostart}"
                     Text="Starts in the tray, without opening the window." />
        </StackPanel>
      </Border>

      <!-- Keyboard -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="Keyboard" />
            <TextBlock Classes="hint" Text="Every right-click menu shows the shortcut next to the action it belongs to. These are all of them." />
          </StackPanel>
          <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.Shortcuts}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShortcutGroup">
                <StackPanel Spacing="2" Margin="0,0,0,12">
                  <TextBlock Classes="label" Text="{Binding Name}" Margin="0,0,0,2" />
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShortcutRow">
                        <Grid ColumnSpacing="16" Margin="0,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" MinWidth="150" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Classes="kbd" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Keys}" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Does}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- About -->
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="section" Text="NAT" />
          <TextBlock Classes="hint" Text="{x:Static vm:SettingsViewModel.About}" />
          <TextBlock Classes="hint" Text="{Binding StorageNote}" IsVisible="{Binding HasStorageNote}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
