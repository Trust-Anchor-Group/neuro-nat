<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.Nat.App.ViewModels"
             xmlns:conv="using:Neuro.Nat.App.Converters"
             xmlns:c="using:Neuro.Nat.App.Controls"
             xmlns:v="using:Neuro.Nat.App.Views"
             x:Class="Neuro.Nat.App.Views.ConsoleView"
             x:DataType="vm:ConsoleViewModel">

  <UserControl.Styles>
    <Style Selector="Border.listPane">
      <Setter Property="Width" Value="300" />
    </Style>
    <!-- A very wide window (1800 px and up): the list gets some of the room, instead of the rest stretching -->
    <Style Selector=".wide Border.listPane">
      <Setter Property="Width" Value="360" />
    </Style>
    <!-- Window width 1000 px or less (classes set by MainWindow; container queries made list scrolling slow) -->
    <Style Selector=".maxw1000 Border.listPane">
      <Setter Property="Width" Value="240" />
    </Style>
    
    <Style Selector="TextBlock.prompt">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.Ink}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
    </Style>
    <Style Selector="Border.result">
      <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,10,10" />
    </Style>
    <Style Selector="ListBox.runbooks ListBoxItem" x:DataType="vm:RunbookItemViewModel">
      <Setter Property="IsVisible" Value="{Binding IsShown}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*">

    <!-- Neurons to talk to. Not shown on a Neuron's page, where the console talks to that Neuron only. -->
    <Border Classes="listPane" c:Pane.Key="console" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" IsVisible="{Binding !IsPinned}">
      <Grid RowDefinitions="*,Auto">
      <DockPanel Margin="12,14,12,8">
        <StackPanel DockPanel.Dock="Top" Margin="6,0,0,10" Spacing="4">
          <TextBlock Classes="section" Text="Neurons" />
          <TextBox x:Name="TargetFilterBox" Classes="find" Text="{Binding TargetFilter}" PlaceholderText="Filter Neurons…" MinHeight="28" Padding="10,4" Margin="-4,6,2,0"
                   ToolTip.Tip="Filter (Ctrl+F)" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Targets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConsoleTargetViewModel">
                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsOnline}" IsVisible="{Binding IsShown}" Margin="2,0,0,6"
                          ToolTip.Tip="{Binding BareJid}"
                          c:ActionMenu.Source="{Binding $parent[UserControl].((vm:ConsoleViewModel)DataContext)}">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="mono" Text="{Binding Label}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowAccount}">
                      <Border Width="14" Height="14" CornerRadius="4" VerticalAlignment="Center"
                              Background="{Binding AccountColorIndex, Converter={x:Static conv:AccountHueConverter.Instance}, ConverterParameter=subtle}">
                        <TextBlock Text="{Binding AccountLabel, Converter={x:Static conv:InitialConverter.Instance}}" FontSize="9" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding AccountColorIndex, Converter={x:Static conv:AccountHueConverter.Instance}}" />
                      </Border>
                      <TextBlock Classes="meta" Text="{Binding AccountLabel}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- Runbooks: named series of commands, run on the Neurons ticked above -->
      <DockPanel Grid.Row="1" Margin="12,0,12,12">
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" Margin="-12,0,-12,12" />
        <DockPanel DockPanel.Dock="Top" Margin="6,0,0,6">
          <Button DockPanel.Dock="Right" Classes="ghost small" Padding="5" Command="{Binding Runbooks.OpenFileCommand}" ToolTip.Tip="Open a runbook file">
            <c:LineIcon Data="{StaticResource Icon.Folder}" Width="14" Height="14" />
          </Button>
          <Button DockPanel.Dock="Right" Classes="ghost small" Padding="5" Command="{Binding Runbooks.NewCommand}" ToolTip.Tip="New runbook">
            <c:LineIcon Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
          </Button>
          <TextBlock Classes="section" Text="Runbooks" VerticalAlignment="Center" />
        </DockPanel>
        <TextBox DockPanel.Dock="Top" Classes="find" Text="{Binding Runbooks.Filter}" PlaceholderText="Filter runbooks…" MinHeight="28" Padding="10,4" Margin="2,0,2,6"
                 IsVisible="{Binding Runbooks.ShowFilter}" />
        <ListBox x:Name="RunbookList" Classes="rows runbooks" ItemsSource="{Binding Runbooks.Items}" SelectedItem="{Binding Runbooks.Selected}" MaxHeight="280"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RunbookItemViewModel">
              <StackPanel Spacing="1" Background="Transparent" ToolTip.Tip="{Binding Title}"
                          c:ActionMenu.Source="{Binding $parent[UserControl].((vm:ConsoleViewModel)DataContext)}">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="meta" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      </Grid>
    </Border>

    <!-- The open runbook, in place of the transcript -->
    <Panel Grid.Column="1" IsVisible="{Binding Runbooks.IsOpen}">
      <v:RunbookView x:Name="RunbookPane" DataContext="{Binding Runbooks}" />
    </Panel>

    <!-- Transcript and input -->
    <DockPanel Grid.Column="1" IsVisible="{Binding !Runbooks.IsOpen}">
      <Border DockPanel.Dock="Top" Padding="24,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding ClearCommand}" ToolTip.Tip="Clear the transcript">
            <StackPanel Classes="btn">
              <c:LineIcon Classes="btn" Data="{StaticResource Icon.Eraser}" />
              <TextBlock Classes="btnLabel" Text="Clear" />
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding SaveTranscriptCommand}" IsVisible="{Binding HasRuns}"
                  ToolTip.Tip="Save">
            <StackPanel Classes="btn">
              <c:LineIcon Classes="btn" Data="{StaticResource Icon.Save}" />
              <TextBlock Classes="btnLabel" Text="Save" />
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding StartPickingCommand}" IsVisible="{Binding CanSaveAsRunbook}"
                  ToolTip.Tip="Save commands as a runbook">
            <StackPanel Classes="btn">
              <c:LineIcon Classes="btn" Data="{StaticResource Icon.File}" />
              <TextBlock Classes="btnLabel" Text="Save as runbook" />
            </StackPanel>
          </Button>
          <StackPanel Spacing="2">
            <TextBlock Classes="section" Text="Chat admin" />
            <TextBlock Classes="meta" Text="{Binding TargetSummary}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Ticking commands for a runbook -->
      <Border DockPanel.Dock="Bottom" Padding="24,10,24,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" IsVisible="{Binding IsPicking}">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox x:Name="PickTitleBox" Text="{Binding PickTitle}" PlaceholderText="Name of the runbook" />
          <TextBlock Grid.Column="1" Classes="meta" Text="{Binding PickSummary}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="primary" Content="Save runbook" Command="{Binding SavePickedCommand}" />
          <Button Grid.Column="3" Classes="ghost" Content="Cancel" Command="{Binding CancelPickingCommand}" />
        </Grid>
      </Border>

      <!-- Input -->
      <Border DockPanel.Dock="Bottom" Padding="24,10,24,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" IsVisible="{Binding !IsPicking}">
        <StackPanel Spacing="8">
          <Border Classes="panel" Padding="12,10" Background="{DynamicResource State.Bad.Subtle}" BorderThickness="0" IsVisible="{Binding IsConfirming}">
            <Grid ColumnDefinitions="*,220,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding ConfirmPrompt}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="ConfirmBox" Grid.Column="1" Text="{Binding ConfirmText}" PlaceholderText="Type to confirm" />
              <Button Grid.Column="2" Classes="danger armed" Content="Run" Command="{Binding RunCommand}" />
              <Button Grid.Column="3" Classes="ghost" Content="Cancel" Command="{Binding CancelConfirmCommand}" />
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="chip" Content="{Binding}" ToolTip.Tip="Tab takes the first one"
                        Command="{Binding $parent[UserControl].((vm:ConsoleViewModel)DataContext).UseSuggestionCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock Classes="prompt" Text="&gt;" VerticalAlignment="Top" Margin="0,9,0,0" />
            <TextBox x:Name="Input" Grid.Column="1" Text="{Binding CommandText}" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="{StaticResource Font.Mono}" MinHeight="40" MaxHeight="240" Padding="10,8"
                     PlaceholderText="A command or script" />
            <Button Grid.Column="2" Classes="primary" Content="Run" Command="{Binding RunCommand}" VerticalAlignment="Bottom" />
          </Grid>
        </StackPanel>
      </Border>

      <Panel>
        <ScrollViewer x:Name="Transcript" Padding="24,14">
          <ItemsControl ItemsSource="{Binding Runs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConsoleRunViewModel">
                <StackPanel Spacing="8" Margin="0,0,0,18">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Background="Transparent"
                        c:ActionMenu.Source="{Binding $parent[UserControl].((vm:ConsoleViewModel)DataContext)}">
                    <CheckBox IsChecked="{Binding IsPicked}" MinWidth="0" Margin="0,-4,-4,-4" ToolTip.Tip="In the runbook"
                              IsVisible="{Binding $parent[UserControl].((vm:ConsoleViewModel)DataContext).IsPicking}" />
                    <TextBlock Grid.Column="1" Classes="prompt" Text="&gt;" />
                    <SelectableTextBlock Grid.Column="2" Classes="mono" Text="{Binding Command}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Time}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConsoleResultViewModel">
                        <Border Classes="result" c:ActionMenu.Source="{Binding $parent[UserControl].((vm:ConsoleViewModel)DataContext)}">
                          <StackPanel Spacing="8">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Classes="ghost small" Margin="6,-4,-6,-4" Padding="5"
                                      ToolTip.Tip="More"
                                      c:ActionMenu.Source="{Binding $parent[UserControl].((vm:ConsoleViewModel)DataContext)}" c:ActionMenu.OnClick="True">
                                <c:LineIcon Data="{StaticResource Icon.More}" Width="14" Height="14" />
                              </Button>
                              <TextBlock DockPanel.Dock="Right" Classes="meta" Text="{Binding Status}" Classes.error="{Binding HasError}" VerticalAlignment="Center" />
                              <TextBlock Classes="mono" Text="{Binding NeuronLabel}" FontWeight="SemiBold" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="10000">
                              <c:MarkdownView Markdown="{Binding Markdown}" />
                            </ScrollViewer>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel IsVisible="{Binding !HasRuns}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="6">
          <c:LineIcon Data="{StaticResource Icon.Console}" Width="24" Height="24" Foreground="{DynamicResource Ink.Tertiary}" HorizontalAlignment="Center" />
          <TextBlock Text="Talk to a Neuron's chat admin" FontWeight="SemiBold" HorizontalAlignment="Center" IsVisible="{Binding !IsPinned}" />
          <TextBlock Text="Talk to this Neuron's chat admin" FontWeight="SemiBold" HorizontalAlignment="Center" IsVisible="{Binding IsPinned}" />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
