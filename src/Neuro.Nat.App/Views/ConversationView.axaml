<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.Nat.App.ViewModels"
             xmlns:conv="using:Neuro.Nat.App.Converters"
             xmlns:c="using:Neuro.Nat.App.Controls"
             xmlns:ch="using:Neuro.Nat.Engine.Chat"
             x:Class="Neuro.Nat.App.Views.ConversationView"
             x:DataType="vm:ChatViewModel">

  <!-- One conversation: who it is with, its messages and the box to write in. Chat shows it
       beside its list, and so does the Inbox when a message row is open. -->
  <UserControl.Styles>
    <!-- Message bubbles: theirs on the panel tint, mine on the accent tint, aligned right. -->
    <Style Selector="Border.bubble">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MaxWidth" Value="640" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.bubble.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.stamp">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- A NAT link in a message: a small card with what it points at -->
    <Style Selector="Button.linkCard">
      <Setter Property="Background" Value="{DynamicResource Surface.Header}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.linkCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
    </Style>
    <Style Selector="TextBlock.stamp.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- A message that names you -->
    <Style Selector="Border.bubble.mention">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- The message being answered, changed or asked about -->
    <Style Selector="Border.bubble.target">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- A message that was taken back: only its place is left -->
    <Style Selector="Border.bubble.gone">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,5" />
    </Style>

    <!-- The panel beside the conversation -->
    <Style Selector="Border.sidePanel">
      <Setter Property="Width" Value="270" />
    </Style>
    <Style Selector=".maxw1100 Border.sidePanel">
      <Setter Property="Width" Value="230" />
    </Style>
    <Style Selector="Border.occupant">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
      <Setter Property="Padding" Value="6,4,2,4" />
    </Style>
    <Style Selector="Border.occupant:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Background" Value="{DynamicResource Surface.Pressed}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.Secondary}" />
    </Style>

    <!-- Emoji: in the picker and among the suggestions -->
    <Style Selector="Button.emoji">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.suggestion.current /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <DockPanel IsVisible="{Binding HasConversation}">
      <Border DockPanel.Dock="Top" Padding="24,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel DataContext="{Binding SelectedPerson}" x:DataType="vm:PersonViewModel">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost" ToolTip.Tip="Notifications">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Tell me about every message" IsVisible="{Binding IsRoom}" ToggleType="Radio" IsChecked="{Binding IsNotifyAll, Mode=OneWay}"
                            Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).SetNotifyCommand}" CommandParameter="{x:Static ch:RoomNotify.All}" />
                  <MenuItem Header="Tell me when I am mentioned" IsVisible="{Binding IsRoom}" ToggleType="Radio" IsChecked="{Binding IsNotifyMentions, Mode=OneWay}"
                            Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).SetNotifyCommand}" CommandParameter="{x:Static ch:RoomNotify.Mentions}" />
                  <Separator IsVisible="{Binding IsRoom}" />
                  <MenuItem Header="Mute for an hour" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).MuteHourCommand}" />
                  <MenuItem Header="Mute until tomorrow" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).MuteTomorrowCommand}" />
                  <MenuItem Header="Mute until I turn it back on" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).MuteForGoodCommand}" />
                  <Separator IsVisible="{Binding IsMuted}" />
                  <MenuItem Header="Turn pop-ups and sounds back on" IsVisible="{Binding IsMuted}"
                            Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).UnmuteCommand}" />
                </MenuFlyout>
              </Button.Flyout>
              <StackPanel Classes="btn">
                <c:LineIcon Classes="btn" Data="{StaticResource Icon.Bell}" IsVisible="{Binding !IsMuted}" />
                <c:LineIcon Classes="btn" Data="{StaticResource Icon.BellOff}" IsVisible="{Binding IsMuted}" />
                <TextBlock Classes="btnLabel" Text="Muted" IsVisible="{Binding IsMuted}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" IsVisible="{Binding IsNeuron}" ToolTip.Tip="Open the console"
                    Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).OpenConsoleCommand}">
              <StackPanel Classes="btn">
                <c:LineIcon Classes="btn" Data="{StaticResource Icon.Console}" />
                <TextBlock Classes="btnLabel" Text="Console" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" IsVisible="{Binding IsRoom}" ToolTip.Tip="People in the room"
                    Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).TogglePanelCommand}">
              <StackPanel Classes="btn">
                <c:LineIcon Classes="btn" Data="{StaticResource Icon.People}" />
                <TextBlock Classes="btnLabel" Text="{Binding OccupantCount, StringFormat='People ({0})'}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" IsVisible="{Binding !IsRoom}" ToolTip.Tip="Details"
                    Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).TogglePanelCommand}">
              <StackPanel Classes="btn">
                <c:LineIcon Classes="btn" Data="{StaticResource Icon.Person}" />
                <TextBlock Classes="btnLabel" Text="Details" />
              </StackPanel>
            </Button>
            <Button x:Name="MoreButton" Classes="ghost" ToolTip.Tip="More"
                    c:ActionMenu.Source="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext)}" c:ActionMenu.OnClick="True">
              <c:LineIcon Classes="btn" Data="{StaticResource Icon.More}" />
            </Button>
          </StackPanel>
          <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="section" Text="{Binding Label}" ToolTip.Tip="{Binding BareJid}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="meta" Text="{Binding PresenceText}" />
              <TextBlock Classes="meta" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="320" IsVisible="{Binding StatusText, Converter={x:Static conv:EventConverters.HasText}}" />
              <TextBlock Classes="meta" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" MaxWidth="320" IsVisible="{Binding IsRoom}" />
              <TextBlock Classes="meta" Text="{Binding ThroughText}" IsVisible="{Binding ThroughText, Converter={x:Static conv:EventConverters.HasText}}" />
            </StackPanel>
            <TextBlock Classes="meta" Text="{Binding SubscriptionNote}" IsVisible="{Binding SubscriptionNote, Converter={x:Static conv:EventConverters.HasText}}" />
            <TextBlock Classes="meta" Text="{Binding NotifyText}" IsVisible="{Binding IsMuted}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding SecurityText, Converter={x:Static conv:EventConverters.HasText}}">
              <c:LineIcon Data="{StaticResource Icon.Lock}" Width="13" Height="13" VerticalAlignment="Center"
                          Foreground="{DynamicResource State.Ok}" IsVisible="{Binding IsEncrypted}" />
              <TextBlock Classes="meta" Text="{Binding SecurityText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- A question that wants an answer first: a reason, a new subject, or "are you sure" -->
      <Border DockPanel.Dock="Top" Padding="24,12" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
              IsVisible="{Binding IsAsking}">
        <StackPanel DataContext="{Binding Ask}" x:DataType="vm:AskViewModel" Spacing="8" MaxWidth="680" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="meta" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding Text, Converter={x:Static conv:EventConverters.HasText}}" />
          <TextBox x:Name="AskInput" Text="{Binding Input}" PlaceholderText="{Binding Placeholder}" IsVisible="{Binding HasInput}" MinWidth="320" />
          <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static conv:EventConverters.HasText}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" IsVisible="{Binding !IsDanger}"
                    Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).ConfirmAskCommand}" />
            <Button Classes="danger armed" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" IsVisible="{Binding IsDanger}"
                    Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).ConfirmAskCommand}" />
            <Button Content="Cancel" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).CancelAskCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Beside the conversation: who is in the room, or the person's details -->
      <Border DockPanel.Dock="Right" Classes="sidePanel" c:Pane.Key="chat.panel" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" IsVisible="{Binding IsPanelOpen}">
        <Panel>
          <!-- A room: the people in it by what they may do, and the banned list when asked for -->
          <DockPanel IsVisible="{Binding IsRoomPanel}" Margin="12,14,8,12">
            <Border DockPanel.Dock="Bottom" Classes="panel" Padding="10" Margin="0,10,4,0" IsVisible="{Binding IsBannedOpen}">
              <StackPanel Spacing="6">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="ghost small" Command="{Binding CloseBannedCommand}" ToolTip.Tip="Close the banned list">
                    <c:LineIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                  </Button>
                  <TextBlock Classes="label" Text="Banned" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Classes="meta" Text="{Binding BannedNote}" TextWrapping="Wrap" IsVisible="{Binding BannedNote, Converter={x:Static conv:EventConverters.HasText}}" />
                <ItemsControl ItemsSource="{Binding Banned}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Classes="small" Content="Let back in" ToolTip.Tip="Lift the ban"
                                Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).LetBackInCommand}" CommandParameter="{Binding}" />
                        <TextBlock Classes="mono" Text="{Binding}" FontSize="{StaticResource Type.Meta}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Occupants}" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OccupantViewModel">
                    <StackPanel>
                      <TextBlock Classes="label" Text="{Binding Header}" IsVisible="{Binding HasHeader}" Margin="6,8,0,4" />
                      <Border Classes="occupant" c:ActionMenu.Source="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext)}">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="ghost small" Padding="6,2" ToolTip.Tip="More"
                                  c:ActionMenu.Source="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext)}" c:ActionMenu.OnClick="True">
                            <c:LineIcon Data="{StaticResource Icon.More}" Width="14" Height="14" />
                          </Button>
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Nick}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <Border Classes="tag" IsVisible="{Binding IsMe}">
                                <TextBlock Text="You" />
                              </Border>
                              <Border Classes="tag" IsVisible="{Binding HasStanding}" ToolTip.Tip="Runs the room">
                                <TextBlock Text="{Binding Standing}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Classes="meta" Text="{Binding Address}" IsVisible="{Binding HasAddress}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Address}" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <!-- A person: the name you gave them, their address and the groups they are in -->
          <ScrollViewer IsVisible="{Binding IsPersonPanel}">
            <StackPanel Spacing="16" Margin="16,16,16,16">
              <StackPanel Spacing="6" IsVisible="{Binding SelectedPerson.InRoster}">
                <TextBlock Classes="label" Text="Name" />
                <TextBox x:Name="NameBox" Text="{Binding DetailName}" PlaceholderText="{Binding SelectedPerson.BareJid}" />
                <Button Classes="primary small" Content="Save name" HorizontalAlignment="Left" Command="{Binding SaveNameCommand}" IsVisible="{Binding CanSaveName}" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="Address" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="ghost small" Padding="6,2" Command="{Binding CopyAddressCommand}" ToolTip.Tip="Copy the address" VerticalAlignment="Top">
                    <c:LineIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" />
                  </Button>
                  <SelectableTextBlock Classes="mono" Text="{Binding SelectedPerson.BareJid}" TextWrapping="Wrap" FontSize="{StaticResource Type.Meta}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding SelectedPerson.ThroughText}"
                           IsVisible="{Binding SelectedPerson.ThroughText, Converter={x:Static conv:EventConverters.HasText}}" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding SelectedPerson.KeyText, Converter={x:Static conv:EventConverters.HasText}}">
                <TextBlock Classes="label" Text="Key" />
                <SelectableTextBlock Classes="mono" Text="{Binding SelectedPerson.KeyText}" TextWrapping="Wrap" FontSize="{StaticResource Type.Meta}" />
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding SelectedPerson.InRoster}">
                <TextBlock Classes="label" Text="Groups" />
                <ItemsControl ItemsSource="{Binding SelectedPerson.Groups}" IsVisible="{Binding SelectedPerson.HasGroups}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border CornerRadius="12" Padding="10,2,2,2" Margin="0,0,6,6" Background="{DynamicResource Surface.Pressed}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <TextBlock Text="{Binding}" FontSize="{StaticResource Type.Meta}" VerticalAlignment="Center" />
                          <Button Classes="ghost" MinHeight="0" Padding="5,4" CornerRadius="10" ToolTip.Tip="Remove from group"
                                  Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).RemoveGroupCommand}" CommandParameter="{Binding}">
                            <c:LineIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="meta" Text="No groups" IsVisible="{Binding !SelectedPerson.HasGroups}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox x:Name="GroupBox" Text="{Binding NewGroup}" PlaceholderText="New group" />
                  <Button Grid.Column="1" Content="Add" Command="{Binding AddGroupCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding OtherGroups}" IsVisible="{Binding HasOtherGroups}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Classes="small" Margin="0,0,6,6" CornerRadius="12" ToolTip.Tip="Add to group"
                              Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).AddToGroupCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <c:LineIcon Data="{StaticResource Icon.Plus}" Width="10" Height="10" />
                          <TextBlock Text="{Binding}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding CanAddOpen}">
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="Not a contact" />
                <Button Content="Add to contacts" HorizontalAlignment="Left" Command="{Binding AddOpenToContactsCommand}" />
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding SelectedPerson.IsPrivate}">
                <Button Content="Open the room" HorizontalAlignment="Left" Command="{Binding OpenRoomOfPrivateCommand}" />
              </StackPanel>

              <TextBlock Classes="error" Text="{Binding DetailError}" TextWrapping="Wrap" IsVisible="{Binding DetailError, Converter={x:Static conv:EventConverters.HasText}}" />

              <Button Classes="danger" HorizontalAlignment="Left" IsVisible="{Binding SelectedPerson.InRoster}" Command="{Binding RemoveOpenContactCommand}">
                <StackPanel Classes="btn">
                  <c:LineIcon Classes="btn" Data="{StaticResource Icon.Trash}" />
                  <TextBlock Classes="btnLabel" Text="Remove from contacts…" />
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>

      <!-- Composer -->
      <Border DockPanel.Dock="Bottom" Padding="24,10,24,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
        <StackPanel Spacing="6">
          <TextBlock Classes="error" Text="{Binding SendError}" TextWrapping="Wrap"
                     IsVisible="{Binding SendError, Converter={x:Static conv:EventConverters.HasText}}" />
          <TextBlock Classes="meta" Text="{Binding FileStatus}" IsVisible="{Binding FileStatus, Converter={x:Static conv:EventConverters.HasText}}" />

          <!-- A room that only lets you read -->
          <DockPanel IsVisible="{Binding SelectedPerson.IsReadOnly}">
            <Button DockPanel.Dock="Right" Classes="small" Content="Ask to speak" Command="{Binding AskToSpeakCommand}"
                    ToolTip.Tip="Ask the moderators" />
            <TextBlock Classes="meta" VerticalAlignment="Center" Text="You can only read here" TextWrapping="Wrap" />
          </DockPanel>

          <!-- Answering or changing a message -->
          <Border Padding="10,6,4,6" CornerRadius="6" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0"
                  IsVisible="{Binding IsBannerOpen}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost small" Padding="6,2" Command="{Binding CancelBannerCommand}" ToolTip.Tip="Cancel (Esc)" VerticalAlignment="Center">
                <c:LineIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
              </Button>
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding BannerTitle}" FontSize="{StaticResource Type.Meta}" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Ink}" />
                <TextBlock Classes="meta" Text="{Binding BannerText}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Emoji for the ":name" being typed -->
          <ItemsControl ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EmojiSuggestion">
                <Button Classes="ghost small suggestion" Classes.current="{Binding IsSelected}" Focusable="False" ToolTip.Tip="Tab or Enter picks it"
                        Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).PickSuggestionCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Choice.Symbol}" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Choice.Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
            <Button x:Name="AttachButton" Classes="ghost" VerticalAlignment="Bottom" IsVisible="{Binding CanSendFiles}"
                    ToolTip.Tip="Send a file">
              <c:LineIcon Classes="btn" Data="{StaticResource Icon.Attach}" />
            </Button>
            <TextBox x:Name="Composer" Grid.Column="1" Text="{Binding Draft}" CaretIndex="{Binding Caret, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="200"
                     PlaceholderText="Write a message" Padding="10,8" />
            <Button x:Name="EmojiButton" Grid.Column="2" Classes="ghost" VerticalAlignment="Bottom"
                    ToolTip.Tip="Emoji">
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight">
                  <ScrollViewer MaxHeight="330" Width="290">
                    <ItemsControl x:Name="EmojiList" ItemsSource="{Binding EmojiGroups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmojiGroup">
                          <StackPanel Margin="0,0,0,8">
                            <TextBlock Classes="label" Text="{Binding Title}" Margin="2,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Items}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EmojiChoice">
                                  <Button Classes="ghost emoji" Content="{Binding Symbol}" ToolTip.Tip="{Binding Hint}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Flyout>
              </Button.Flyout>
              <c:LineIcon Classes="btn" Data="{StaticResource Icon.Smile}" />
            </Button>
            <Button Grid.Column="3" Classes="primary" Content="{Binding SendText}" Command="{Binding SendCommand}" VerticalAlignment="Bottom" Margin="4,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <Panel>
      <ScrollViewer x:Name="MessageScroller" Padding="24,14" DragDrop.AllowDrop="True">
        <StackPanel>
        <Button x:Name="OlderButton" Classes="ghost small" Content="Show older messages" HorizontalAlignment="Center" Margin="0,0,0,10"
                IsVisible="{Binding HasOlder}" />
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageViewModel">
              <StackPanel Spacing="3" Margin="0,2">
                <StackPanel.Margin>
                  <Binding Path="StartsGroup" Converter="{x:Static conv:BoolToThicknessConverter.GroupGap}" />
                </StackPanel.Margin>
                <!-- Where you stopped reading -->
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,4,0,8" IsVisible="{Binding IsFirstNew}">
                  <Border Height="1" Background="{DynamicResource Accent}" VerticalAlignment="Center" Opacity="0.6" />
                  <TextBlock Grid.Column="1" Text="New" FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Ink}" />
                  <Border Grid.Column="2" Height="1" Background="{DynamicResource Accent}" VerticalAlignment="Center" Opacity="0.6" />
                </Grid>
                <TextBlock Classes="meta" Text="{Binding Sender}" FontWeight="SemiBold" IsVisible="{Binding ShowSender}" Margin="2,0,0,0" />
                <Border Classes="bubble" Classes.mine="{Binding IsMine}" Classes.mention="{Binding IsMention}" Classes.target="{Binding IsTarget}" Classes.gone="{Binding IsDeleted}"
                        c:ActionMenu.Source="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext)}">
                  <Panel>
                    <StackPanel Spacing="6" IsVisible="{Binding !IsDeleted}">
                      <c:MarkdownView Markdown="{Binding Markdown}" />
                      <!-- A NAT link: what it points at and how that is now. A click opens it. -->
                      <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding HasCards}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LinkCardViewModel">
                            <Button Classes="linkCard" ToolTip.Tip="{Binding Text}"
                                    Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).OpenLinkCardCommand}" CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Ellipse Classes="dot" Classes.ok="{Binding IsOk}" Classes.busy="{Binding IsBusy}" Classes.bad="{Binding IsBad}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Classes="meta" Text="{Binding State}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <TextBlock Classes="meta" FontStyle="Italic" Text="{Binding DeletedText}" IsVisible="{Binding IsDeleted}" />
                  </Panel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowStamp}"
                            HorizontalAlignment="{Binding IsMine, Converter={x:Static conv:BoolToTextConverter.RightIfTrue}}">
                  <c:LineIcon Data="{StaticResource Icon.Lock}" Width="11" Height="11" VerticalAlignment="Center" IsVisible="{Binding IsEncrypted}"
                              Foreground="{DynamicResource Ink.Tertiary}" ToolTip.Tip="End-to-end encrypted" />
                  <TextBlock Classes="meta" Text="{Binding StampText}" />
                </StackPanel>
                <TextBlock Classes="error stamp" Classes.mine="{Binding IsMine}" Text="{Binding Error}" TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static conv:EventConverters.HasText}}" />
                <Button Classes="small" Content="Send again" HorizontalAlignment="Right" IsVisible="{Binding IsFailed}"
                        Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).SendAgainCommand}" CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- The room's settings, over the messages while they are open -->
      <Border Background="{DynamicResource Surface.Ground}" Padding="24,14" IsVisible="{Binding IsRoomFormOpen}">
        <DockPanel MaxWidth="680" HorizontalAlignment="Left">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Content="Cancel" Command="{Binding CancelRoomFormCommand}" />
              <Button Classes="primary" Content="Save settings" Command="{Binding SaveRoomFormCommand}" IsEnabled="{Binding !IsRoomFormBusy}" />
            </StackPanel>
            <StackPanel Spacing="2" Margin="0,0,12,0">
              <TextBlock Classes="section" Text="{Binding RoomFormTitle}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding RoomFormError}" TextWrapping="Wrap" Margin="0,0,0,10"
                     IsVisible="{Binding RoomFormError, Converter={x:Static conv:EventConverters.HasText}}" />
          <Border Classes="panel" Background="{DynamicResource Surface.Panel}">
            <ScrollViewer Padding="18,14">
              <c:DataFormView Form="{Binding RoomForm}" />
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
      </Panel>
    </DockPanel>

    <StackPanel IsVisible="{Binding !HasConversation}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Spacing="6">
      <TextBlock Text="Pick someone to talk to" FontWeight="SemiBold" HorizontalAlignment="Center" />
    </StackPanel>
  </Panel>
</UserControl>
