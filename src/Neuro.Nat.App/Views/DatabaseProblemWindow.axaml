<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Neuro.Nat.App.ViewModels"
        x:Class="Neuro.Nat.App.Views.DatabaseProblemWindow"
        x:DataType="vm:DatabaseProblemViewModel"
        Title="NAT" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Ground}">

  <Border Classes="card" Margin="16">
    <StackPanel Spacing="12" Margin="4">
      <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource Ink.Secondary}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Classes="ghost" Content="Quit" Command="{Binding QuitCommand}" />
        <Button Content="Start fresh" Command="{Binding StartFreshCommand}"
                ToolTip.Tip="Move what was saved aside" />
        <Button Classes="primary" Content="Try again" Command="{Binding TryAgainCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
