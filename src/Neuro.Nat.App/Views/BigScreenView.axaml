<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.Nat.App.ViewModels"
             xmlns:conv="using:Neuro.Nat.App.Converters"
             xmlns:c="using:Neuro.Nat.App.Controls"
             x:Class="Neuro.Nat.App.Views.BigScreenView"
             x:DataType="vm:BigScreenViewModel"
             Background="{DynamicResource Surface.Ground}">

  <UserControl.Styles>
    <Style Selector="TextBlock.bigNum">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFeatures" Value="tnum" />
    </Style>
    <Style Selector="TextBlock.bigNum.alarm">
      <Setter Property="Foreground" Value="{DynamicResource State.Bad}" />
    </Style>
    <Style Selector="TextBlock.bigCap">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.Tertiary}" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.bigSub">
      <Setter Property="Foreground" Value="{DynamicResource Ink.Secondary}" />
    </Style>
    <Style Selector="TextBlock.bigBad">
      <Setter Property="Foreground" Value="{DynamicResource State.Bad}" />
    </Style>
    <Style Selector="Border.bigTile">
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Many Neurons: small tiles with the name, the state, CPU and errors. Every tile is as tall as the others, so the rows can be counted. -->
    <Style Selector="ItemsControl Border.bigTile">
      <Setter Property="Height" Value="224" />
    </Style>
    <Style Selector="ItemsControl.small Border.bigTile">
      <Setter Property="Height" Value="136" />
    </Style>
    <Style Selector="ItemsControl.small :is(Control).full">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl:not(.small) :is(Control).small">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="StackPanel.tileBody">
      <Setter Property="Margin" Value="16,13,16,14" />
    </Style>
    <Style Selector="ItemsControl.small StackPanel.tileBody">
      <Setter Property="Margin" Value="14,11,14,12" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Fill" Value="{DynamicResource Line.Strong}" />
    </Style>
    <Style Selector="Ellipse.dot.current">
      <Setter Property="Fill" Value="{DynamicResource Ink.Primary}" />
    </Style>
  </UserControl.Styles>

  <!-- The big screen is drawn for a 1280 px wide screen and scaled to the one it is on, so it is as large as the screen allows. -->
  <LayoutTransformControl x:Name="Scale">
    <Grid x:Name="Stage" Margin="34,26,34,18" RowDefinitions="*,Auto">

      <!-- The page: what it is about at the top, and what it shows. It slides when it turns, unless motion is off. -->
      <DockPanel x:Name="Turnable">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,260,24" VerticalAlignment="Center" MinHeight="72">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Ellipse Width="18" Height="18" VerticalAlignment="Center" IsVisible="{Binding HasHeadDot}"
                     Fill="{Binding HeadTone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
            <TextBlock x:Name="HeadlineText" Text="{Binding Headline}" FontSize="36" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock x:Name="SublineText" Text="{Binding Subline}" FontSize="19" Margin="32,6,0,0"
                     Classes="bigSub" Classes.bigBad="{Binding IsSublineBad}" />
        </StackPanel>

        <Panel x:Name="Pages">

          <!-- Neurons: every Neuron as a tile, and the latest warnings and errors -->
          <DockPanel x:Name="NeuronsPage" IsVisible="{Binding IsNeuronsPage}">
            <Border x:Name="LatestPanel" DockPanel.Dock="Right" Width="400" Margin="10,0,0,0" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
              <DockPanel Margin="20,16,20,10">
                <TextBlock DockPanel.Dock="Top" Text="Latest problems" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Panel>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasLatest}" Spacing="6">
                    <TextBlock Text="All quiet" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource State.Ok}" />
                  </StackPanel>
                  <ItemsControl x:Name="LatestList" ItemsSource="{Binding Latest}" IsVisible="{Binding HasLatest}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <c:WholeStack />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BigScreenEventViewModel">
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,9">
                          <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,12,2"
                                    Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                            <DockPanel DockPanel.Dock="Top">
                              <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="15" Foreground="{DynamicResource Ink.Tertiary}" Margin="10,0,0,0" />
                              <TextBlock Text="{Binding Neuron}" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}"
                                         Foreground="{DynamicResource Ink.Secondary}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Title}" FontSize="17" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </DockPanel>
            </Border>

            <Panel x:Name="TileHost">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasTiles}" Spacing="8">
                <TextBlock Text="No Neurons yet" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </StackPanel>
              <!-- The tiles of this page, drawn as wide as fits and made smaller together, never below the smallest that reads from across a room. More Neurons take more pages. -->
              <Viewbox x:Name="TileBox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasTiles}">
                <ItemsControl x:Name="TileList" ItemsSource="{Binding PageTiles}" Width="{Binding TileListWidth}" Classes.small="{Binding SmallTiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BigScreenTileViewModel">
                      <Border Classes="bigTile">
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="6" Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                          <StackPanel Classes="tileBody">
                            <!-- The whole name, smaller when it is long: a Neuron is never half named. -->
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="25">
                              <TextBlock Text="{Binding Label}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" />
                            </Viewbox>
                            <TextBlock Classes="full" Text="{Binding StateText}" FontSize="16" Margin="0,3,0,12" TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                            <TextBlock Classes="small" Text="{Binding ShortState}" FontSize="16" Margin="0,3,0,8" TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                            <Grid Classes="small" ColumnDefinitions="3*,2*" ColumnSpacing="8">
                              <StackPanel>
                                <TextBlock Classes="bigNum" Classes.alarm="{Binding HighCpu}" Text="{Binding Cpu}" />
                                <TextBlock Classes="bigCap" Text="CPU" />
                              </StackPanel>
                              <StackPanel Grid.Column="1">
                                <TextBlock Classes="bigNum" Classes.alarm="{Binding HasErrors}" Text="{Binding Errors}" />
                                <TextBlock Classes="bigCap" Text="Errors" />
                              </StackPanel>
                            </Grid>
                            <Grid Classes="full" ColumnDefinitions="4*,3*,4*" ColumnSpacing="10">
                              <StackPanel>
                                <TextBlock Classes="bigNum" Classes.alarm="{Binding HighCpu}" Text="{Binding Cpu}" />
                                <TextBlock Classes="bigCap" Text="CPU" />
                              </StackPanel>
                              <StackPanel Grid.Column="1">
                                <TextBlock Classes="bigNum" Classes.alarm="{Binding HasErrors}" Text="{Binding Errors}" />
                                <TextBlock Classes="bigCap" Text="Errors" />
                              </StackPanel>
                              <StackPanel Grid.Column="2">
                                <TextBlock Classes="bigNum" Text="{Binding Issues}" />
                                <TextBlock Classes="bigCap" Text="Problems" />
                              </StackPanel>
                            </Grid>
                            <Grid Classes="full" ColumnDefinitions="4*,7*" ColumnSpacing="10" Margin="0,12,0,0">
                              <StackPanel>
                                <TextBlock FontSize="17" FontWeight="Medium" Text="{Binding Memory}" Classes.bigBad="{Binding LowMemory}" />
                                <TextBlock Classes="bigCap" Text="Memory" />
                              </StackPanel>
                              <StackPanel Grid.Column="1">
                                <TextBlock FontSize="17" FontWeight="Medium" Text="{Binding Disk}" Classes.bigBad="{Binding LowDisk}" />
                                <TextBlock Classes="bigCap" Text="Disk free" />
                              </StackPanel>
                            </Grid>
                            <TextBlock Classes="bigCap full" Margin="0,12,0,0" TextTrimming="CharacterEllipsis">
                              <Run Text="Last event" />
                              <Run Text="{Binding LastEvent}" />
                            </TextBlock>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Viewbox>
            </Panel>
          </DockPanel>

          <!-- Problems: what, where, since when, and how many times -->
          <DockPanel x:Name="ProblemsPage" IsVisible="{Binding IsProblemsPage}">
            <ItemsControl x:Name="ProblemList" ItemsSource="{Binding PageProblems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:WholeStack />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BigScreenProblemViewModel">
                  <Border Classes="bigProblem" Margin="0,0,0,10" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="6" Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                      <StackPanel DockPanel.Dock="Left" Width="112" Margin="20,12,0,12" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Count}" FontSize="46" FontWeight="SemiBold" FontFeatures="tnum" LineHeight="50"
                                   Foreground="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding CountUnit}" FontSize="17" Foreground="{DynamicResource Ink.Tertiary}" />
                      </StackPanel>
                      <StackPanel Margin="8,14,22,14" VerticalAlignment="Center" Spacing="6">
                        <DockPanel>
                          <Border DockPanel.Dock="Right" IsVisible="{Binding IsNew}" Background="{DynamicResource Accent.Subtle}"
                                  CornerRadius="{StaticResource Radius.Pill}" Padding="12,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="New" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                          </Border>
                          <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" FontSize="20" Foreground="{DynamicResource Ink.Tertiary}" Margin="16,0,0,0">
                            <Run Text="{Binding Since}" /><Run Text=", " /><Run Text="{Binding Last}" />
                          </TextBlock>
                          <TextBlock Text="{Binding Where}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource Ink.Secondary}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>

          <!-- A page a feature added -->
          <ContentControl x:Name="AddedPage" IsVisible="{Binding IsAddedPage}" Content="{Binding AddedContent}" />
        </Panel>
      </DockPanel>

      <!-- The time stays where it is while the pages turn -->
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
        <TextBlock x:Name="ClockText" Text="{Binding Clock}" FontSize="48" FontWeight="SemiBold" FontFeatures="tnum" HorizontalAlignment="Right" LineHeight="50" />
        <TextBlock Text="{Binding Date}" FontSize="17" Foreground="{DynamicResource Ink.Secondary}" HorizontalAlignment="Right" />
      </StackPanel>

      <!-- Which page this is, and how to leave -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="0,10,0,0">
        <ItemsControl Grid.Column="1" x:Name="DotList" ItemsSource="{Binding Dots}" IsVisible="{Binding HasDots}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BigScreenPage">
              <Ellipse Classes="dot" Classes.current="{Binding IsCurrent}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="HeldText" Text="Held" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink.Secondary}" IsVisible="{Binding Held}" />
          <TextBlock x:Name="LeaveHint" Text="Esc or F11 to leave" FontSize="14" Foreground="{DynamicResource Ink.Tertiary}" />
        </StackPanel>
      </Grid>
    </Grid>
  </LayoutTransformControl>
</UserControl>
