<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.AA.App.ViewModels"
             xmlns:c="using:Neuro.AA.App.Controls"
             xmlns:ps="using:Neuro.AA.Engine.PubSub"
             x:Class="Neuro.AA.App.Views.PubSubView"
             x:DataType="vm:PubSubViewModel">

  <UserControl.Styles>
    <Style Selector="Border.listPane">
      <Setter Property="Width" Value="340" />
    </Style>
    <Style Selector="ToggleButton.seg">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="{StaticResource Type.Meta}" />
    </Style>
    <Style Selector="ToggleButton.seg.first">
      <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="ToggleButton.seg.last">
      <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>
    <!-- Window width 1100 px or less (classes set by MainWindow; container queries made list scrolling slow) -->
    <Style Selector=".maxw1100 Border.listPane">
      <Setter Property="Width" Value="270" />
    </Style>
    
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*">

    <!-- Nodes -->
    <Border Classes="listPane" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,14,12,12">
        <TextBlock DockPanel.Dock="Top" Classes="section" Text="Publish/subscribe" Margin="6,0,0,10" />
        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding AccountChoices}" SelectedItem="{Binding Account}" HorizontalAlignment="Stretch" Margin="6,0,0,10" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,8">
          <ToggleButton Classes="seg first" IsChecked="{Binding IsService, Mode=OneWay}" Command="{Binding SetPersonalCommand}" CommandParameter="service"
                        ToolTip.Tip="Nodes on the server's publish/subscribe service">
            <TextBlock Text="Service" />
          </ToggleButton>
          <ToggleButton Classes="seg last" IsChecked="{Binding IsPersonal, Mode=OneWay}" Margin="-1,0,0,0" Command="{Binding SetPersonalCommand}" CommandParameter="personal"
                        ToolTip.Tip="The account's personal storage (PEP): avatar, nickname, keys">
            <TextBlock Text="Personal" />
          </ToggleButton>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="meta" Text="{Binding ServiceText}" TextTrimming="CharacterEllipsis" Margin="6,0,0,10" />

        <DockPanel DockPanel.Dock="Bottom" Margin="6,10,0,0" IsVisible="{Binding IsService}">
          <Button DockPanel.Dock="Right" Content="Create" Command="{Binding CreateNodeCommand}" IsEnabled="{Binding !IsBusy}" Margin="8,0,0,0" />
          <TextBox Text="{Binding NewNodeName}" PlaceholderText="New node name" MinHeight="28" Padding="10,4" />
        </DockPanel>

        <Panel>
          <ListBox Classes="rows" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="ps:PubSubNodeInfo">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Node}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="meta" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel IsVisible="{Binding !HasNodes}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="260" Spacing="6">
            <c:LineIcon Data="{StaticResource Icon.PubSub}" Width="24" Height="24" Foreground="{DynamicResource Ink.Tertiary}" HorizontalAlignment="Center" />
            <TextBlock Classes="meta" TextAlignment="Center" TextWrapping="Wrap" Text="No nodes here yet." />
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>

    <!-- The node -->
    <Panel Grid.Column="1">
      <DockPanel IsVisible="{Binding HasNode}" Margin="24,16,24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button Classes="ghost" Command="{Binding ReloadCommand}" IsEnabled="{Binding !IsBusy}">
              <TextBlock Text="Refresh" FontSize="{StaticResource Type.Meta}" />
            </Button>
            <Button Classes="danger" Content="Delete node…" Command="{Binding AskDeleteCommand}" IsVisible="{Binding IsService}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="{Binding SelectedNode.Node}" TextWrapping="Wrap" />
            <TextBlock Classes="meta" Text="{Binding SelectedNode.Service}" />
          </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" IsVisible="{Binding IsConfirmingDelete}" Background="{DynamicResource State.Bad.Subtle}"
                CornerRadius="{StaticResource Radius}" Padding="14,10" Margin="0,0,0,14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
              <Button Classes="danger armed" Content="Delete node" Command="{Binding DeleteNodeCommand}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Delete this node and everything published on it? Subscribers are told it is gone. This cannot be undone." />
          </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,0,0,12"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Publish -->
        <Border DockPanel.Dock="Bottom" Classes="panel" Background="{DynamicResource Surface.Panel}" Padding="14,12" Margin="0,14,0,0">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="Publish an item" />
            <TextBox Text="{Binding PublishXml}" AcceptsReturn="True" MinHeight="70" MaxHeight="160" Classes="mono" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding PublishItemId}" PlaceholderText="Item id (optional)" Width="220" MinHeight="30" />
              <Button Classes="primary" Content="Publish" Command="{Binding PublishCommand}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Panel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PubSubItemRow">
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="ghost" VerticalAlignment="Top" ToolTip.Tip="Remove this item from the node"
                              Command="{Binding $parent[UserControl].((vm:PubSubViewModel)DataContext).RetractCommand}" CommandParameter="{Binding}">
                        <TextBlock Text="Retract" FontSize="{StaticResource Type.Meta}" />
                      </Button>
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="mono" Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Classes="meta" Text="{Binding Meta}" />
                        </StackPanel>
                        <Border Background="{DynamicResource Surface.Code}" CornerRadius="6" Padding="10,8">
                          <SelectableTextBlock Classes="mono" Text="{Binding PrettyXml}" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Classes="meta" Text="Nothing published on this node." IsVisible="{Binding !HasItems}" VerticalAlignment="Top" />
        </Panel>
      </DockPanel>

      <StackPanel IsVisible="{Binding !HasNode}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Spacing="6">
        <TextBlock Text="Pick a node" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="meta" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Error}" />
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>
