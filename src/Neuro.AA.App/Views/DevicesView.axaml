<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.AA.App.ViewModels"
             xmlns:conv="using:Neuro.AA.App.Converters"
             xmlns:c="using:Neuro.AA.App.Controls"
             x:Class="Neuro.AA.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">

  <UserControl.Styles>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.pill TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.listPane">
      <Setter Property="Width" Value="380" />
    </Style>
    <!-- Window width 1100 px or less (classes set by MainWindow; container queries made list scrolling slow) -->
    <Style Selector=".maxw1100 Border.listPane">
      <Setter Property="Width" Value="300" />
    </Style>
    
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*">

    <!-- The list -->
    <Border Classes="listPane" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,14,12,12">
        <DockPanel DockPanel.Dock="Top" Margin="6,0,0,10">
          <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding StartClaimCommand}" ToolTip.Tip="Take ownership of a device with its key">
            <TextBlock Text="Claim" FontSize="{StaticResource Type.Meta}" />
          </Button>
          <TextBlock Classes="section" Text="Devices" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,10">
          <ToggleButton Classes="seg first" IsChecked="{Binding IsMine, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:DevicesMode.Mine}">
            <TextBlock Text="Mine" />
          </ToggleButton>
          <ToggleButton Classes="seg" IsChecked="{Binding IsSearch, Mode=OneWay}" Margin="-1,0,0,0" Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:DevicesMode.Search}">
            <TextBlock Text="Registry" />
          </ToggleButton>
          <ToggleButton Classes="seg last" IsChecked="{Binding IsQuestions, Mode=OneWay}" Margin="-1,0,0,0" Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:DevicesMode.Questions}">
            <TextBlock Text="{Binding QuestionsLabel}" />
          </ToggleButton>
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="6,0,0,10" IsVisible="{Binding IsSearch}">
          <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" IsEnabled="{Binding !IsBusy}" Margin="8,0,0,0" IsDefault="True" />
          <TextBox Classes="find" Text="{Binding SearchText}" PlaceholderText="Name, model, serial number…" MinHeight="28" Padding="10,4" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Classes="meta" Text="{Binding Note}" TextWrapping="Wrap" Margin="6,8,0,0"
                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Panel>
          <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceRowViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                  <Border Grid.RowSpan="2" Width="22" Height="22" CornerRadius="5" VerticalAlignment="Top"
                          Background="{Binding AccountColorIndex, Converter={x:Static conv:AccountHueConverter.Instance}, ConverterParameter=subtle}"
                          ToolTip.Tip="{Binding AccountLabel}">
                    <TextBlock Text="{Binding AccountLabel, Converter={x:Static conv:InitialConverter.Instance}}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding AccountColorIndex, Converter={x:Static conv:AccountHueConverter.Instance}}" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2" Classes="pill" IsVisible="{Binding HasState}"
                          Background="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}, ConverterParameter=subtle}">
                    <TextBlock Text="{Binding StateLabel}" Foreground="{Binding Tone, Converter={x:Static conv:ToneBrushConverter.Instance}}" />
                  </Border>
                  <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Classes="meta" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding !HasRows}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="290" Spacing="6">
            <c:LineIcon Data="{StaticResource Icon.Devices}" Width="24" Height="24" Foreground="{DynamicResource Ink.Tertiary}" HorizontalAlignment="Center" />
            <TextBlock Classes="meta" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding EmptyText}" />
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>

    <!-- The selection -->
    <Panel Grid.Column="1">
      <DockPanel IsVisible="{Binding HasSelection}" Margin="24,16,24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button Classes="danger" Content="Give up…" IsVisible="{Binding CanDisown}" Command="{Binding AskDisownCommand}"
                    ToolTip.Tip="Stop owning this device. It goes back to the registry, unclaimed." />
          </StackPanel>
          <StackPanel Spacing="4" Margin="0,0,16,0">
            <TextBlock Classes="title" Text="{Binding DetailTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="meta" Text="{Binding DetailSubtitle}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" IsVisible="{Binding IsConfirmingDisown}" Background="{DynamicResource State.Bad.Subtle}"
                CornerRadius="{StaticResource Radius}" Padding="14,10" Margin="0,0,0,14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Content="Cancel" Command="{Binding CancelDisownCommand}" />
              <Button Classes="danger armed" Content="Give it up" Command="{Binding DisownCommand}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Give up this device? Anyone with its key can claim it after you, and the rules you gave it are removed." />
          </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,0,0,12"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <!-- Device or question facts -->
            <Border Classes="panel" Background="{DynamicResource Surface.Panel}" Padding="16,12" IsVisible="{Binding !IsClaiming}">
              <ItemsControl ItemsSource="{Binding Facts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DeviceFact">
                    <Grid ColumnDefinitions="140,*" Margin="0,4">
                      <TextBlock Classes="meta" Text="{Binding Name}" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <!-- Answer a question -->
            <StackPanel Spacing="12" IsVisible="{Binding ShowsQuestion}">
              <TextBlock Classes="section" Text="Your answer applies to" />
              <StackPanel Spacing="6">
                <RadioButton GroupName="scope" Content="Only the one who asks" IsChecked="{Binding ScopeIndex, Converter={x:Static conv:IndexConverters.Is0}}" />
                <RadioButton GroupName="scope" Content="Everyone on their domain" IsChecked="{Binding ScopeIndex, Converter={x:Static conv:IndexConverters.Is1}}" />
                <RadioButton GroupName="scope" Content="Everyone" IsVisible="{Binding IsFriendship}" IsChecked="{Binding ScopeIndex, Converter={x:Static conv:IndexConverters.Is2}}" />
              </StackPanel>
              <TextBlock Classes="meta" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                         Text="The device remembers the answer as a rule, so the same question is not asked again. Clear the devices' rules from the Mine list to start over." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Deny" Command="{Binding AnswerCommand}" CommandParameter="reject" IsEnabled="{Binding !IsBusy}" />
                <Button Classes="primary" Content="Allow" Command="{Binding AnswerCommand}" CommandParameter="accept" IsEnabled="{Binding !IsBusy}" />
              </StackPanel>
            </StackPanel>

            <!-- Claim -->
            <StackPanel Spacing="12" IsVisible="{Binding IsClaiming}">
              <StackPanel Spacing="4" IsVisible="{Binding !IsOneAccount}">
                <TextBlock Classes="label" Text="Account" />
                <ComboBox ItemsSource="{Binding AccountChoices}" SelectedItem="{Binding Account}" MinWidth="260" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="Tags, one per line" />
                <TextBox Text="{Binding ClaimTags}" AcceptsReturn="True" MinHeight="110" Width="420" HorizontalAlignment="Left" Classes="mono"
                         PlaceholderText="KEY=…&#10;SN=…" />
              </StackPanel>
              <CheckBox IsChecked="{Binding ClaimPublic}" Content="Keep it findable in the registry" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelClaimCommand}" />
                <Button Classes="primary" Content="Claim device" Command="{Binding ClaimCommand}" IsEnabled="{Binding !IsBusy}" />
              </StackPanel>
            </StackPanel>

            <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding ClearCachesCommand}" IsVisible="{Binding IsMine}"
                    ToolTip.Tip="Your devices forget the access rules they have cached and ask again">
              <TextBlock Text="Make my devices ask again" FontSize="{StaticResource Type.Meta}" />
            </Button>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <StackPanel IsVisible="{Binding !HasSelection}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Spacing="6">
        <TextBlock Text="Pick a device or a question" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="meta" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Devices you own answer to you: when someone wants to read, control or befriend them, the question waits here." />
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>
