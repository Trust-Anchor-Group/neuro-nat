<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Neuro.AA design tokens. Views reference these keys only; never raw colours.
    Light and dark are both designed (not inverted). Contrast targets: body text 4.5:1 or
    more on its surface, secondary text 4.5:1, tertiary text only for non-essential labels.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Surfaces -->
      <SolidColorBrush x:Key="Surface.Ground" Color="#F5F6F8" />
      <SolidColorBrush x:Key="Surface.Panel" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface.Hover" Color="#F0F2F5" />
      <SolidColorBrush x:Key="Surface.Pressed" Color="#E7EAEE" />
      <SolidColorBrush x:Key="Surface.Rail" Color="#ECEEF2" />
      <SolidColorBrush x:Key="Surface.Code" Color="#FAFBFC" />
      <!-- Lines -->
      <SolidColorBrush x:Key="Line" Color="#E2E5EA" />
      <SolidColorBrush x:Key="Line.Strong" Color="#CDD2D9" />
      <!-- Ink -->
      <SolidColorBrush x:Key="Ink.Primary" Color="#12161C" />
      <SolidColorBrush x:Key="Ink.Secondary" Color="#545D6B" />
      <SolidColorBrush x:Key="Ink.Tertiary" Color="#6B7480" />
      <SolidColorBrush x:Key="Ink.OnAccent" Color="#FFFFFF" />
      <!-- Accent: selection, primary action, focus. Nothing else. -->
      <SolidColorBrush x:Key="Accent" Color="#3358D4" />
      <SolidColorBrush x:Key="Accent.Hover" Color="#2A4BBE" />
      <SolidColorBrush x:Key="Accent.Subtle" Color="#EAEFFC" />
      <SolidColorBrush x:Key="Accent.Ink" Color="#2440A8" />
      <!-- Connection state -->
      <SolidColorBrush x:Key="State.Ok" Color="#1E8A4C" />
      <SolidColorBrush x:Key="State.Busy" Color="#B26B00" />
      <SolidColorBrush x:Key="State.Bad" Color="#C8312B" />
      <SolidColorBrush x:Key="State.Bad.Subtle" Color="#FCEBEA" />
      <SolidColorBrush x:Key="State.Idle" Color="#8A929E" />
      <!-- Event severity ramp (Debug to Emergency), used from Phase 1 -->
      <SolidColorBrush x:Key="Severity.Debug" Color="#8A929E" />
      <SolidColorBrush x:Key="Severity.Informational" Color="#545D6B" />
      <SolidColorBrush x:Key="Severity.Notice" Color="#3358D4" />
      <SolidColorBrush x:Key="Severity.Warning" Color="#B26B00" />
      <SolidColorBrush x:Key="Severity.Error" Color="#C8312B" />
      <SolidColorBrush x:Key="Severity.Critical" Color="#A11A4B" />
      <SolidColorBrush x:Key="Severity.Alert" Color="#8E1B6E" />
      <SolidColorBrush x:Key="Severity.Emergency" Color="#6B1D8F" />
      <!-- Account hues: only on account dots, chips and avatars -->
      <SolidColorBrush x:Key="Account.Hue0" Color="#3B6FE0" />
      <SolidColorBrush x:Key="Account.Hue1" Color="#0F9488" />
      <SolidColorBrush x:Key="Account.Hue2" Color="#7C4DDB" />
      <SolidColorBrush x:Key="Account.Hue3" Color="#C27C0E" />
      <SolidColorBrush x:Key="Account.Hue4" Color="#D23F6C" />
      <SolidColorBrush x:Key="Account.Hue5" Color="#3A8F3A" />
      <SolidColorBrush x:Key="Account.Hue6" Color="#0C86B5" />
      <SolidColorBrush x:Key="Account.Hue7" Color="#D2601A" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Surface.Ground" Color="#101215" />
      <SolidColorBrush x:Key="Surface.Panel" Color="#16191D" />
      <SolidColorBrush x:Key="Surface.Hover" Color="#1D2126" />
      <SolidColorBrush x:Key="Surface.Pressed" Color="#242930" />
      <SolidColorBrush x:Key="Surface.Rail" Color="#0C0E11" />
      <SolidColorBrush x:Key="Surface.Code" Color="#121519" />
      <SolidColorBrush x:Key="Line" Color="#252A31" />
      <SolidColorBrush x:Key="Line.Strong" Color="#353C46" />
      <SolidColorBrush x:Key="Ink.Primary" Color="#E6E9ED" />
      <SolidColorBrush x:Key="Ink.Secondary" Color="#A3ABB6" />
      <SolidColorBrush x:Key="Ink.Tertiary" Color="#838B96" />
      <SolidColorBrush x:Key="Ink.OnAccent" Color="#0B0D10" />
      <SolidColorBrush x:Key="Accent" Color="#7B9BFF" />
      <SolidColorBrush x:Key="Accent.Hover" Color="#94AEFF" />
      <SolidColorBrush x:Key="Accent.Subtle" Color="#1C2541" />
      <SolidColorBrush x:Key="Accent.Ink" Color="#B4C6FF" />
      <SolidColorBrush x:Key="State.Ok" Color="#45C27D" />
      <SolidColorBrush x:Key="State.Busy" Color="#E5A63F" />
      <SolidColorBrush x:Key="State.Bad" Color="#F26D64" />
      <SolidColorBrush x:Key="State.Bad.Subtle" Color="#2E1A1A" />
      <SolidColorBrush x:Key="State.Idle" Color="#6E7682" />
      <SolidColorBrush x:Key="Severity.Debug" Color="#6E7682" />
      <SolidColorBrush x:Key="Severity.Informational" Color="#A3ABB6" />
      <SolidColorBrush x:Key="Severity.Notice" Color="#7B9BFF" />
      <SolidColorBrush x:Key="Severity.Warning" Color="#E5A63F" />
      <SolidColorBrush x:Key="Severity.Error" Color="#F26D64" />
      <SolidColorBrush x:Key="Severity.Critical" Color="#F0608F" />
      <SolidColorBrush x:Key="Severity.Alert" Color="#D06BD0" />
      <SolidColorBrush x:Key="Severity.Emergency" Color="#B488FF" />
      <SolidColorBrush x:Key="Account.Hue0" Color="#6E98FF" />
      <SolidColorBrush x:Key="Account.Hue1" Color="#36C2B4" />
      <SolidColorBrush x:Key="Account.Hue2" Color="#A887FF" />
      <SolidColorBrush x:Key="Account.Hue3" Color="#E7A93C" />
      <SolidColorBrush x:Key="Account.Hue4" Color="#F07399" />
      <SolidColorBrush x:Key="Account.Hue5" Color="#6CC46C" />
      <SolidColorBrush x:Key="Account.Hue6" Color="#4BB8E6" />
      <SolidColorBrush x:Key="Account.Hue7" Color="#F08A4B" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type: Inter for UI, the platform monospace for JIDs, XML and timestamps. -->
  <FontFamily x:Key="Font.UI">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, SF Mono, Menlo, JetBrains Mono, DejaVu Sans Mono, monospace</FontFamily>
  <x:Double x:Key="Type.Caption">11</x:Double>
  <x:Double x:Key="Type.Meta">12</x:Double>
  <x:Double x:Key="Type.Body">13</x:Double>
  <x:Double x:Key="Type.Section">15</x:Double>
  <x:Double x:Key="Type.Title">18</x:Double>

  <!-- Shape -->
  <CornerRadius x:Key="Radius">6</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <!-- Line icons, 24 x 24 grid, drawn with LineIcon (stroke follows the text colour). -->
  <StreamGeometry x:Key="Icon.Attention">M4 13.5l2.5-8h11l2.5 8v5H4z M4 13.5h4.5l1 2h5l1-2H20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Lock">M7 11V8a5 5 0 0 1 10 0v3 M5.5 11h13v9h-13z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Attach">M20 11.5l-8.2 8.2a5 5 0 0 1-7.1-7.1l8.5-8.5a3.3 3.3 0 0 1 4.7 4.7l-8.5 8.5a1.7 1.7 0 0 1-2.4-2.4l7.8-7.8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Share">M12 3.5v12 M7.5 8l4.5-4.5L16.5 8 M5 13.5v6h14v-6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Room">M9 4.5l-2 15 M17 4.5l-2 15 M4.5 9h15 M4 15h15</StreamGeometry>
  <StreamGeometry x:Key="Icon.Accounts">M12 12a4 4 0 1 0 0-8a4 4 0 1 0 0 8 M4.5 20c.8-3.3 3.8-5.5 7.5-5.5s6.7 2.2 7.5 5.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Fleet">M4 4.5h16v6H4z M4 13.5h16v6H4z M7.5 7.5h.01 M7.5 16.5h.01 M11 7.5h6 M11 16.5h6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Events">M3 12h4l2.5-7l5 14l2.5-7h4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sources">M6 3.5v11 M6 20.5a2.5 2.5 0 1 0 0-5a2.5 2.5 0 1 0 0 5 M18 8.5a2.5 2.5 0 1 0 0-5a2.5 2.5 0 1 0 0 5 M18 8.5c0 5-6 4-12 7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Chat">M20.5 11.5a8 8 0 0 1-11.8 7L4 19.5l1-4.4a8 8 0 1 1 15.5-3.6z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Console">M4 4.5h16v15H4z M8 9.5l3 2.5l-3 2.5 M13 14.5h3.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Topology">M12 8.5a2.5 2.5 0 1 0 0-5a2.5 2.5 0 1 0 0 5 M5.5 20.5a2.5 2.5 0 1 0 0-5a2.5 2.5 0 1 0 0 5 M18.5 20.5a2.5 2.5 0 1 0 0-5a2.5 2.5 0 1 0 0 5 M10.8 8.2l-4 7.6 M13.2 8.2l4 7.6 M8 18h8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Identities">M3.5 5.5h17v13h-17z M9.5 11.5a2 2 0 1 0 0-4a2 2 0 1 0 0 4 M6.5 15.5c.6-1.6 1.6-2.4 3-2.4s2.4.8 3 2.4 M15 9.5h3 M15 13h3</StreamGeometry>
  <StreamGeometry x:Key="Icon.Updates">M12 3.5v11 M7.5 10l4.5 4.5l4.5-4.5 M4.5 15.5v3a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-3</StreamGeometry>
  <StreamGeometry x:Key="Icon.Devices">M7 3.5h10a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5H7A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5z M10.5 17.5h3</StreamGeometry>
  <StreamGeometry x:Key="Icon.PubSub">M12 13.5a1.5 1.5 0 1 0 0-3a1.5 1.5 0 1 0 0 3 M8.5 8.5a5 5 0 0 0 0 7 M15.5 8.5a5 5 0 0 1 0 7 M5.6 5.6a9 9 0 0 0 0 12.8 M18.4 5.6a9 9 0 0 1 0 12.8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M12 5v14 M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Close">M6 6l12 12 M18 6L6 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plug">M9 3.5v4 M15 3.5v4 M6.5 7.5h11v3a5.5 5.5 0 0 1-11 0z M12 16v4.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Unplug">M9 3.5v4 M15 3.5v4 M6.5 7.5h11v3a5.5 5.5 0 0 1-11 0z M12 16v4.5 M3.5 3.5l17 17</StreamGeometry>
  <StreamGeometry x:Key="Icon.Trash">M4.5 6.5h15 M9.5 6.5v-2h5v2 M6.5 6.5l1 13h9l1-13 M10.5 10v6 M13.5 10v6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Pause">M8.5 5v14 M15.5 5v14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Play">M7 4.5l12 7.5l-12 7.5z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Eraser">M14.5 4.5l5 5l-9 9h-5l-2.5-2.5a1.5 1.5 0 0 1 0-2.1z M9 10l5 5 M10.5 18.5h9</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sniffer">M4 6.5h16 M4 12h10 M4 17.5h13</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sun">M12 16a4 4 0 1 0 0-8a4 4 0 1 0 0 8 M12 2.5v2 M12 19.5v2 M2.5 12h2 M19.5 12h2 M5.3 5.3l1.4 1.4 M17.3 17.3l1.4 1.4 M5.3 18.7l1.4-1.4 M17.3 6.7l1.4-1.4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Moon">M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Alert">M12 4l9 16H3z M12 10v4 M12 17h.01</StreamGeometry>
</ResourceDictionary>
