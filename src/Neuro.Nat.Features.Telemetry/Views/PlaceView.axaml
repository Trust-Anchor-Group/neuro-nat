<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neuro.Nat.Features.Telemetry.ViewModels"
             xmlns:views="using:Neuro.Nat.Features.Telemetry.Views"
             x:Class="Neuro.Nat.Features.Telemetry.Views.PlaceView"
             x:DataType="vm:TelemetryPlaceViewModel">

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="20,8" Background="{DynamicResource Surface.Ground}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Text="Collector" Classes="label" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" IsVisible="{Binding HasPicker}" AutomationProperties.Name="Telemetry collector"
                  ItemsSource="{Binding Collectors}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  HorizontalAlignment="Left" MaxWidth="520" HorizontalContentAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CollectorChoice">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="1" IsVisible="{Binding !HasPicker}" Text="{Binding Selected.Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
    </Border>
    <views:DashboardView DataContext="{Binding Current}" />
  </DockPanel>
</UserControl>
