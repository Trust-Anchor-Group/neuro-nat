<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Neuro.AA.Desktop</RootNamespace>
    <AssemblyName>Neuro.AA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Neuro.AA.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Where installed copies look for updates by default; see Install/VelopackUpdates.cs. -->
    <UpdateSource Condition="'$(UpdateSource)' == ''">https://github.com/berggrenmille/Neuro-AA</UpdateSource>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateSource" Value="$(UpdateSource)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neuro.AA.App\Neuro.AA.App.csproj" />
  </ItemGroup>

</Project>
